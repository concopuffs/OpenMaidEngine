<Project>
  <!-- A Debug build with Optimize=true (drive.py port start, option optimize) shares its output folder with ordinary
       Debug builds, because Godot's editor binary loads only .godot/mono/temp/bin/Debug. MSBuild's incremental compile
       hashes DefineConstants but not Optimize, so this define makes a change of Optimize recompile in either direction
       instead of leaving the other mode's assemblies in place. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(Optimize)' == 'true'">
    <DefineConstants>$(DefineConstants);OME_OPTIMIZED_DEBUG</DefineConstants>
  </PropertyGroup>

  <!-- The two programs a release ships, the engine (godot/OME.csproj) and the launcher
       (launcher/Ome.Launcher/Ome.Launcher.csproj), opt into what follows with OmeProgram=true (launcher plan §9.1). -->

  <!-- The version each program shows, the engine in ﾍﾙﾌﾟ > ﾊﾞｰｼﾞｮﾝ情報 and the launcher in About
       (Ome.Engine.Frontend.Shell.EngineIdentity): git describe of the checkout, "+" when it has uncommitted changes,
       unless the build passes -p:OmeVersion=... A build without git or a repository stores none, which both show as
       "unknown". -->
  <Target Name="OmeVersion" BeforeTargets="GetAssemblyAttributes" Condition="'$(OmeProgram)' == 'true'">
    <Exec Condition="'$(OmeVersion)' == ''" Command="git describe --tags --match &quot;v[0-9]*&quot; --dirty=+ --always"
          WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true"
          IgnoreStandardErrorWarningFormat="true" EchoOff="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_OmeDescribed" />
      <Output TaskParameter="ExitCode" PropertyName="_OmeDescribeExit" />
    </Exec>
    <PropertyGroup>
      <OmeVersion Condition="'$(OmeVersion)' == '' and '$(_OmeDescribeExit)' == '0'">$(_OmeDescribed)</OmeVersion>
    </PropertyGroup>
    <ItemGroup Condition="'$(OmeVersion)' != ''">
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>OmeVersion</_Parameter1>
        <_Parameter2>$(OmeVersion)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <!-- A self-contained publish ships NuGet packages' files: the .NET runtime pack, Tomlyn, Avalonia's and
       others. Each of those packages' own license and notice files (LICENSE*, THIRD-PARTY-NOTICES*,
       NOTICE* at the package root) is published as <PackageId>-<file name>, in OmePackageNoticeFolder when the program
       names one, else beside the program's files (THIRD_PARTY_NOTICES.md, ".NET"; the packagers require the runtime
       pack's). A single file leaves them out of its bundle. -->
  <Target Name="PublishPackageNotices" AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(OmeProgram)' == 'true' and '$(SelfContained)' == 'true'">
    <PropertyGroup>
      <_OmeNoticePrefix Condition="'$(OmePackageNoticeFolder)' != ''">$([MSBuild]::EnsureTrailingSlash('$(OmePackageNoticeFolder)'))</_OmeNoticePrefix>
    </PropertyGroup>
    <ItemGroup>
      <_OmeShippedPackage Include="%(ResolvedFileToPublish.NuGetPackageId)"
                          Condition="'%(ResolvedFileToPublish.NuGetPackageId)' != ''">
        <NuGetPackageId>%(ResolvedFileToPublish.NuGetPackageId)</NuGetPackageId>
        <NuGetPackageVersion>%(ResolvedFileToPublish.NuGetPackageVersion)</NuGetPackageVersion>
      </_OmeShippedPackage>
    </ItemGroup>
    <GetPackageDirectory Items="@(_OmeShippedPackage)" PackageFolders="@(AssetsFilePackageFolder)">
      <Output TaskParameter="Output" ItemName="_OmeShippedPackageDirectory" />
    </GetPackageDirectory>
    <ItemGroup>
      <_OmePackageNotice Include="%(_OmeShippedPackageDirectory.PackageDirectory)/LICENSE*;%(_OmeShippedPackageDirectory.PackageDirectory)/THIRD-PARTY-NOTICES*;%(_OmeShippedPackageDirectory.PackageDirectory)/NOTICE*"
                         Condition="'%(_OmeShippedPackageDirectory.PackageDirectory)' != ''">
        <PackageId>%(_OmeShippedPackageDirectory.NuGetPackageId)</PackageId>
      </_OmePackageNotice>
      <ResolvedFileToPublish Include="@(_OmePackageNotice)"
                             RelativePath="$(_OmeNoticePrefix)%(_OmePackageNotice.PackageId)-%(_OmePackageNotice.Filename)%(_OmePackageNotice.Extension)"
                             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>
</Project>
