<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The mock's classes as Avalonia styles (launcher plan §6.1), over Fluent. Each selector names the mock's class it
       stands for; the colours are Palette.axaml's brushes, so one style serves both themes. -->

  <!-- body: the window's ground, text colour and type. -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource OmeWinBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OmeTextBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- .muted, .mono, and the headings: .side-head h2, .card h3, .form h3 (uppercased by the view), .head h1. -->
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource OmeMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource OmeMonoFontFamily}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBox.mono">
    <Setter Property="FontFamily" Value="{DynamicResource OmeMonoFontFamily}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LetterSpacing" Value="0.9" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource OmeMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="23" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.dialog-title">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.strong">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.ok"><Setter Property="Foreground" Value="{DynamicResource OmeOkBrush}" /></Style>
  <Style Selector="TextBlock.warn"><Setter Property="Foreground" Value="{DynamicResource OmeWarnBrush}" /></Style>
  <Style Selector="TextBlock.bad"><Setter Property="Foreground" Value="{DynamicResource OmeBadBrush}" /></Style>
  <Style Selector="TextBlock.run"><Setter Property="Foreground" Value="{DynamicResource OmeRunBrush}" /></Style>

  <!-- .btn and its kinds: .primary, .play, .wide, .running, .link. -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource OmeCardBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OmeTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OmeLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="11,5" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource OmeHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OmeLineBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OmeTextBrush}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource OmeHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OmeLineBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OmeTextBrush}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource OmeCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OmeLineBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OmeTextBrush}" />
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource OmeInkBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OmeInkTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OmeInkBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource OmeInkBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OmeInkBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OmeInkTextBrush}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Opacity" Value="0.88" />
  </Style>
  <Style Selector="Button.play">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Padding" Value="30,10" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.running">
    <Setter Property="Background" Value="{DynamicResource OmeRunBgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OmeRunBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.running:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource OmeRunBgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OmeRunBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.wide">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="7" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource OmeMutedBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource OmeTextBrush}" />
  </Style>
  <Style Selector="Button.link:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource OmeMutedBrush}" />
  </Style>

  <!-- .chip and its states. -->
  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="9,1" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource OmeLineBrush}" />
    <Setter Property="Background" Value="{DynamicResource OmeCardBrush}" />
  </Style>
  <Style Selector="Border.chip > TextBlock">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Border.chip.ok"><Setter Property="Background" Value="{DynamicResource OmeOkBgBrush}" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
  <Style Selector="Border.chip.ok > TextBlock"><Setter Property="Foreground" Value="{DynamicResource OmeOkBrush}" /></Style>
  <Style Selector="Border.chip.warn"><Setter Property="Background" Value="{DynamicResource OmeWarnBgBrush}" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
  <Style Selector="Border.chip.warn > TextBlock"><Setter Property="Foreground" Value="{DynamicResource OmeWarnBrush}" /></Style>
  <Style Selector="Border.chip.bad"><Setter Property="Background" Value="{DynamicResource OmeBadBgBrush}" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
  <Style Selector="Border.chip.bad > TextBlock"><Setter Property="Foreground" Value="{DynamicResource OmeBadBrush}" /></Style>
  <Style Selector="Border.chip.run"><Setter Property="Background" Value="{DynamicResource OmeRunBgBrush}" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
  <Style Selector="Border.chip.run > TextBlock"><Setter Property="Foreground" Value="{DynamicResource OmeRunBrush}" /></Style>

  <!-- .dot, the state beside a profile's name. -->
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Fill" Value="{DynamicResource OmeOkBrush}" />
  </Style>
  <Style Selector="Ellipse.dot.warn"><Setter Property="Fill" Value="{DynamicResource OmeWarnBrush}" /></Style>
  <Style Selector="Ellipse.dot.bad"><Setter Property="Fill" Value="{DynamicResource OmeBadBrush}" /></Style>
  <Style Selector="Ellipse.dot.run"><Setter Property="Fill" Value="{DynamicResource OmeRunBrush}" /></Style>
  <Style Selector="Ellipse.dot.checking"><Setter Property="Fill" Value="{DynamicResource OmeLineBrush}" /></Style>

  <!-- .prow, a profile in the list, and .prow.sel with its ink bar. -->
  <Style Selector="Button.prow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,3,0,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.prow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource OmeHoverBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.prow.sel">
    <Setter Property="Background" Value="{DynamicResource OmeSelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OmeLineBrush}" />
  </Style>
  <Style Selector="Button.prow.sel:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource OmeSelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OmeLineBrush}" />
  </Style>
  <Style Selector="Rectangle.selbar">
    <Setter Property="Fill" Value="{DynamicResource OmeInkBrush}" />
    <Setter Property="Width" Value="3" />
  </Style>

  <!-- .tabs button and .tabs button.on, with .count. -->
  <Style Selector="Button.tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="13,8,13,9" />
    <Setter Property="Margin" Value="0,0,0,-1" />
    <Setter Property="Foreground" Value="{DynamicResource OmeMutedBrush}" />
  </Style>
  <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.tab:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource OmeTextBrush}" />
  </Style>
  <Style Selector="Button.tab:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource OmeMutedBrush}" />
  </Style>
  <Style Selector="Button.tab:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Button.tab.on">
    <Setter Property="Foreground" Value="{DynamicResource OmeTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OmeInkBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.tab.on:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.tab.on:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource OmeInkBrush}" />
  </Style>
  <Style Selector="Border.count">
    <Setter Property="Background" Value="{DynamicResource OmeBadBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Margin" Value="5,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.count > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <!-- .wizard: a dialog over the scrim. -->
  <Style Selector="Border.dialog">
    <Setter Property="Background" Value="{DynamicResource OmeWinBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="24,20" />
    <Setter Property="BoxShadow" Value="0 20 60 0 #66000000" />
  </Style>

  <!-- .side, .card, .notice, and the rules between rows. -->
  <Style Selector="Border.side">
    <Setter Property="Background" Value="{DynamicResource OmeSideBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OmeLineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource OmeCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OmeLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="15,13" />
  </Style>
  <Style Selector="Border.notice">
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="12,9" />
  </Style>
  <Style Selector="Border.notice.bad"><Setter Property="Background" Value="{DynamicResource OmeBadBgBrush}" /></Style>
  <Style Selector="Border.notice.bad TextBlock.notice-text"><Setter Property="Foreground" Value="{DynamicResource OmeBadBrush}" /></Style>
  <Style Selector="Border.notice.warn"><Setter Property="Background" Value="{DynamicResource OmeWarnBgBrush}" /></Style>
  <Style Selector="Border.notice.warn TextBlock.notice-text"><Setter Property="Foreground" Value="{DynamicResource OmeWarnBrush}" /></Style>
  <Style Selector="Border.notice.run"><Setter Property="Background" Value="{DynamicResource OmeRunBgBrush}" /></Style>
  <Style Selector="Border.notice.run TextBlock.notice-text"><Setter Property="Foreground" Value="{DynamicResource OmeRunBrush}" /></Style>
  <Style Selector="TextBlock.card-title">
    <Setter Property="Margin" Value="0,0,0,9" />
  </Style>
  <Style Selector="TextBlock.mark">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.strong-link">
    <Setter Property="Foreground" Value="{DynamicResource OmeTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary.danger">
    <Setter Property="Background" Value="{DynamicResource OmeBadBrush}" />
  </Style>
  <Style Selector="Button.primary.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource OmeBadBrush}" />
  </Style>
  <Style Selector="Border.log">
    <Setter Property="Background" Value="{DynamicResource OmeCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OmeLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,6" />
  </Style>
  <Style Selector="SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource OmeMonoFontFamily}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <!-- The Mods tab: the mock's .mlist, .mrow (grip, .switch, name and id, chip), .mrow.engine and .report. -->
  <Style Selector="Border.mlist">
    <Setter Property="Background" Value="{DynamicResource OmeCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OmeLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.mrow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource OmeLineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.mrow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.mrow.sel"><Setter Property="Background" Value="{DynamicResource OmeHoverBrush}" /></Style>
  <Style Selector="Button.mrow.sel:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource OmeHoverBrush}" />
  </Style>
  <Style Selector="Button.mrow.drop">
    <Setter Property="BorderBrush" Value="{DynamicResource OmeInkBrush}" />
    <Setter Property="BorderThickness" Value="0,2,0,0" />
  </Style>
  <Style Selector="Button.mrow.drop:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource OmeInkBrush}" />
  </Style>
  <Style Selector="Button.mrow.off TextBlock.mname"><Setter Property="Opacity" Value="0.55" /></Style>
  <Style Selector="Button.mrow.off TextBlock.mid"><Setter Property="Opacity" Value="0.55" /></Style>
  <Style Selector="Border.mrow">
    <Setter Property="BorderBrush" Value="{DynamicResource OmeLineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="TextBlock.mname"><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.mid">
    <Setter Property="Foreground" Value="{DynamicResource OmeMutedBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Border.grip">
    <Setter Property="Cursor" Value="SizeNorthSouth" />
    <Setter Property="Height" Value="24" />
  </Style>
  <Style Selector="Border.grip > Path"><Setter Property="Fill" Value="{DynamicResource OmeMutedBrush}" /></Style>
  <Style Selector="Path.diamond"><Setter Property="Fill" Value="{DynamicResource OmeMutedBrush}" /></Style>
  <Style Selector="Rectangle.dropline">
    <Setter Property="Height" Value="2" />
    <Setter Property="Fill" Value="{DynamicResource OmeInkBrush}" />
  </Style>
  <Style Selector="Button.switch">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="17" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{DynamicResource OmeLineBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.switch:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.switch:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.switch:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource OmeLineBrush}" />
  </Style>
  <Style Selector="Button.switch.on"><Setter Property="Background" Value="{DynamicResource OmeOkBrush}" /></Style>
  <Style Selector="Button.switch.on:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.switch.on:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.switch.on:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource OmeOkBrush}" />
  </Style>
  <Style Selector="Ellipse.knob">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="Fill" Value="White" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.switch.on Ellipse.knob"><Setter Property="HorizontalAlignment" Value="Right" /></Style>
  <Style Selector="TextBlock.tag">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LetterSpacing" Value="0.5" />
    <Setter Property="Foreground" Value="{DynamicResource OmeMutedBrush}" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>
  <Style Selector="TextBlock.tag.bad">
    <Setter Property="Foreground" Value="{DynamicResource OmeBadBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.rline">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.rline:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.rline:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.rline:pointerover TextBlock"><Setter Property="TextDecorations" Value="Underline" /></Style>
  <Style Selector="Button.rline:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- The profile tabs' forms (Settings, Saves, Advanced): the mock's .form, .frow, .help, .radio and .input.sel. -->
  <Style Selector="StackPanel.form">
    <Setter Property="MaxWidth" Value="720" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="TextBlock.form-heading"><Setter Property="Margin" Value="0,18,0,8" /></Style>
  <Style Selector="TextBlock.form-heading.first"><Setter Property="Margin" Value="0,0,0,8" /></Style>
  <Style Selector="Border.frow">
    <Setter Property="BorderBrush" Value="{DynamicResource OmeLineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="0,6" />
    <Setter Property="MinHeight" Value="40" />
  </Style>
  <Style Selector="Border.frow > Grid"><Setter Property="VerticalAlignment" Value="Center" /></Style>
  <Style Selector="Border.field">
    <Setter Property="Background" Value="{DynamicResource OmeFieldBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OmeLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="9,5" />
  </Style>
  <Style Selector="TextBlock.help">
    <Setter Property="Foreground" Value="{DynamicResource OmeMutedBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>
  <Style Selector="TextBlock.help.bad"><Setter Property="Foreground" Value="{DynamicResource OmeBadBrush}" /></Style>
  <Style Selector="ComboBox.field">
    <Setter Property="Background" Value="{DynamicResource OmeFieldBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OmeLineBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OmeTextBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinWidth" Value="190" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="ComboBox.field:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource OmeFieldBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OmeMutedBrush}" />
  </Style>
  <Style Selector="Button.radio">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,3" />
    <Setter Property="Margin" Value="0,0,14,0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.radio:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.radio:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.radio:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Ellipse.radio-dot">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="Stroke" Value="{DynamicResource OmeMutedBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="Fill" Value="Transparent" />
  </Style>
  <Style Selector="Button.radio.on Ellipse.radio-dot">
    <Setter Property="Stroke" Value="{DynamicResource OmeInkBrush}" />
    <Setter Property="StrokeThickness" Value="4" />
  </Style>

  <Style Selector="Border.rule-top">
    <Setter Property="BorderBrush" Value="{DynamicResource OmeLineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Border.rule-bottom">
    <Setter Property="BorderBrush" Value="{DynamicResource OmeLineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
</Styles>
