<Project Sdk="Microsoft.NET.Sdk">

  <!-- OME-Launcher (launcher spec §8.1): the Avalonia window over Ome.Launcher.Core, and the command line that runs
       before it (spec §8.6). A windowed program: on Windows it attaches to its parent's console to print (launcher
       plan §3.5). net10.0, the one project that is (plan §5). -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>OME-Launcher</AssemblyName>
    <RootNamespace>Ome.Launcher</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The OME icon, drawn from godot/assets/ome-icon.svg by tools/launcher_icon_build.py (launcher plan §10): the
         program's own icon on Windows, and the window's (Views/MainWindow.axaml). -->
    <ApplicationIcon>Assets\ome-icon.ico</ApplicationIcon>
    <!-- A binding names a property of its x:DataType, so a missing one fails the build, not the page (plan §6). -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The version stamp and the package notices of a release program (Directory.Build.targets); the launcher's
         notices go in a folder of their own beside it, so they do not crowd the archive's root (plan §9.1). -->
    <OmeProgram>true</OmeProgram>
    <OmePackageNoticeFolder>OME-Launcher-notices</OmePackageNoticeFolder>
  </PropertyGroup>

  <!-- The release form, which `dotnet publish -r <rid>` gives with no other flag (launcher plan §3.1, §3.3, §9.1): a
       self-contained single file with Avalonia's native libraries beside it, so nothing is unpacked outside the
       folder; no compression, no ReadyToRun (its publish does not fit the runner, §3.7), no trimming (spec §10). A
       build or test with no runtime identifier is unchanged. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <!-- Avalonia's build-time telemetry (its README: a machine id, the hashed machine name, OS, CI detection) runs
         from this package's build targets on every build. Excluding its assets removes the target, so no build of
         this project sends it, whatever the environment holds (launcher plan §3.10, §3.12). -->
    <PackageReference Include="Avalonia.BuildServices" Version="11.3.2" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\engine\Ome.Launcher.Core\Ome.Launcher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The port's bundled font (shell §11), so Japanese titles read the same on every OS (spec §9). -->
    <AvaloniaResource Include="..\..\godot\assets\NotoSansJP-Regular.otf" Link="Assets\Fonts\NotoSansJP-Regular.otf" />
    <AvaloniaResource Include="Assets\ome-icon.ico" />
    <!-- The launcher's string tables (spec §8.8), one per language. -->
    <EmbeddedResource Include="Strings\*.json" LogicalName="Ome.Launcher.Strings.%(Filename).json" />
    <!-- The licences About opens (plan §6.11), beside the built program. A publish leaves them out: the release
         archive's root holds them beside the launcher (plan §9.1). -->
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- SkiaSharp's and HarfBuzzSharp's native packages publish their native libraries' symbols, about 100 MiB on
       win-x64; a release does not ship them (launcher plan §3.1). -->
  <Target Name="DropNativeSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <!-- -p:OmeDependencyList=FILE keeps the publish's dependency list, which a single file bundles and so hides: the
       release's notices check reads it (tools/publish_launcher.py, launcher plan §9.1). A single file's list is written
       to IntermediateDepsFilePath (the SDK leaves PublishDepsFilePath empty for it). -->
  <Target Name="KeepDependencyList" AfterTargets="GeneratePublishDependencyFile"
          Condition="'$(OmeDependencyList)' != ''">
    <Error Condition="!Exists('$(IntermediateDepsFilePath)')"
           Text="the publish's dependency list was not found: $(IntermediateDepsFilePath)" />
    <Copy SourceFiles="$(IntermediateDepsFilePath)" DestinationFiles="$(OmeDependencyList)" />
  </Target>

</Project>
