<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ome.Launcher.ViewModels"
             x:Class="Ome.Launcher.Views.DuplicateView"
             x:DataType="vm:DuplicateViewModel"
             Width="560">
  <!-- Duplicate (spec §8.4): the copy's name, its saves, and where it goes. -->
  <StackPanel Spacing="10">
    <TextBlock Classes="dialog-title" Text="{Binding Title}" />
    <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
      <TextBlock VerticalAlignment="Center" Text="{Binding S[wizard.name]}" />
      <TextBox Grid.Column="1" Text="{Binding Name}" AutomationProperties.Name="{Binding S[wizard.name]}" />

      <TextBlock Grid.Row="1" VerticalAlignment="Top" Margin="0,2,0,0" Text="{Binding S[saves.title]}" />
      <StackPanel Grid.Row="1" Grid.Column="1">
        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding CanLeaveSaves}">
          <Button Classes="switch" Classes.on="{Binding WithSaves}" Command="{Binding ToggleSaves}"
                  VerticalAlignment="Center" AutomationProperties.Name="{Binding S[duplicate.saves]}">
            <Ellipse Classes="knob" />
          </Button>
          <TextBlock VerticalAlignment="Center" Text="{Binding S[duplicate.saves]}" />
        </StackPanel>
        <TextBlock Classes="help" TextWrapping="Wrap" Text="{Binding S[duplicate.saves-always]}"
                   IsVisible="{Binding CannotLeaveSaves}" />
      </StackPanel>

      <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="{Binding S[wizard.location]}" />
      <DockPanel Grid.Row="2" Grid.Column="1">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
          <Button Content="{Binding S[wizard.choose]}" Command="{Binding ChooseLocation}" />
          <Button Content="{Binding S[wizard.default]}" Command="{Binding DefaultLocation}" />
        </StackPanel>
        <Border Classes="field">
          <TextBlock Classes="mono small" TextTrimming="LeadingCharacterEllipsis" Text="{Binding LocationText}"
                     ToolTip.Tip="{Binding LocationText}" />
        </Border>
      </DockPanel>
    </Grid>
    <Border Classes="notice bad" IsVisible="{Binding HasError}">
      <TextBlock Classes="notice-text" TextWrapping="Wrap" Text="{Binding Error}" />
    </Border>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
      <Button Content="{Binding S[confirm.cancel]}" Command="{Binding Cancel}" />
      <Button Classes="primary" Content="{Binding S[duplicate.create]}" Command="{Binding Create}" />
    </StackPanel>
  </StackPanel>
</UserControl>
