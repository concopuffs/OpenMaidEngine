# Port only (scenarios/port/): data patches, a copy the game makes from an edited field (plan §5.3, the derived
# values). example.unit-stats raises リリィ's (unit 2) stats.max_hp from 14 to 40 at himegari.data.layered. A new game's
# GAMESTART calls UNITECH, which copies her definition into her saved state on her first join, so at SC0000 page 3
# both her definition (unit_base_stats) and her saved stats (unit_current_stats) hold 40; she joins at her starting
# level 1, so no growth is added. The run saves slot 0 there through the ADV menu. Then, on the same sandbox started
# without the mod, himegari-unit-stats-load-without.steps loads it. Run on a new sandbox:
#   py -3.11 -X utf8 tools/drive.py port start --sandbox dp-unit-stats --mod oms/examples/mods/example.unit-stats
#   py -3.11 -X utf8 tools/drive.py port run tools/drive/scenarios/port/himegari-unit-stats.steps
# Cells by number: party_slot_character_id 0x67a0, unit_current_levels 0x6930, unit_current_stats 0x69f8 and
# unit_base_stats 0x7af36 (int[...][14], column 11 max_hp).

wait-state script=TITLE click=adv.next every=3 timeout=120   # click through the logos and opening movie
wait 1.5
click title.start
wait-state script=GAMESTART timeout=20
wait 1
click newgame.begin
wait-state top=SC0000@0x83f timeout=60                       # page 1
settle
advance 2
expect top=SC0000@0x8a9                                      # page 3
lua local g = maid.vm.g local got = string.format("slot2=%d level=%d base_max_hp=%d max_hp=%d", g[0x67a0 + 2], g[0x6930 + 2], g[0x7af36 + 2 * 14 + 11], g[0x69f8 + 2 * 14 + 11]) assert(got == "slot2=2 level=1 base_max_hp=40 max_hp=40", got) return got
rclick adv.next                                              # the menu opens on the character tab
wait 1.5
click menu.save
wait 1.5
click slot.0
wait 1.5
click confirm.yes
wait 2
rclick adv.next                                              # back to the page
wait 1.5
expect top=SC0000@0x8a9
shot unit-stats-saved
