@guard sub clear_message_layer {
    gfx_elem_erase(0xd354, 0x4)
    clear_message_text()
    return
}
@guard sub place_layer_graphic {
    G[0xfd437] = op_0x215(G[0xfd43b][G[0xfd435]])
    if G[0xfd437] < 0x0 {
        if G[0xfd435] <= 0x7 {
            G[0xfd459] = 0x400 / 0x2
            G[0xfd45a] = 0x240
        } else {
            G[0xfd459] = 0x0
            G[0xfd45a] = 0x0
        }
        goto place_layer_graphic_1
    }
    op_0x21a(G[0xfd43b][G[0xfd435]], out G[0xfd456], out G[0xfd457], out G[0xfd458])
    op_0x218(G[0xfd43b][G[0xfd435]], out G[0xfd459], out G[0xfd45a], out G[0xfd45b])
    get_texture_size(G[0xfd437], out G[0xfd438], out G[0xfd439])
    if G[0xfd45c] == 0x0 {
        G[0xfd459] = G[0xfd456]
        G[0xfd45a] = G[0xfd457]
        goto place_layer_graphic_1
    }
    if G[0xfd45c] == 0x1 {
        G[0xfd459] = G[0xfd456] + G[0xfd438] / 0x2
        G[0xfd45a] = G[0xfd457]
        goto place_layer_graphic_1
    }
    if G[0xfd45c] == 0x2 {
        G[0xfd459] = G[0xfd456] + G[0xfd438]
        G[0xfd45a] = G[0xfd457]
        goto place_layer_graphic_1
    }
    if G[0xfd45c] == 0x3 {
        G[0xfd459] = G[0xfd456]
        G[0xfd45a] = G[0xfd457] + G[0xfd439] / 0x2
        goto place_layer_graphic_1
    }
    if G[0xfd45c] == 0x4 {
        G[0xfd459] = G[0xfd456] + G[0xfd438] / 0x2
        G[0xfd45a] = G[0xfd457] + G[0xfd439] / 0x2
        goto place_layer_graphic_1
    }
    if G[0xfd45c] == 0x5 {
        G[0xfd459] = G[0xfd456] + G[0xfd438]
        G[0xfd45a] = G[0xfd457] + G[0xfd439] / 0x2
        goto place_layer_graphic_1
    }
    if G[0xfd45c] == 0x6 {
        G[0xfd459] = G[0xfd456]
        G[0xfd45a] = G[0xfd457] + G[0xfd439]
        goto place_layer_graphic_1
    }
    if G[0xfd45c] == 0x7 {
        G[0xfd459] = G[0xfd456] + G[0xfd438] / 0x2
        G[0xfd45a] = G[0xfd457] + G[0xfd439]
        goto place_layer_graphic_1
    }
    if G[0xfd45c] == 0x8 {
        G[0xfd459] = G[0xfd456] + G[0xfd438]
        G[0xfd45a] = G[0xfd457] + G[0xfd439]
    }
place_layer_graphic_1:
    G[0xfd45b] = 0x0
    return
}
