    set_anim_clock(0x7d0)
    mark_frame_yield()
    present_window_transition()
    return
}
@guard sub publish_message_text {
    gfx_elem_erase(0xd6d8, 0x1f4)
    gfx_elem_erase(0xe678, 0x1f4)
    if G[0x4f9] & G[0x306e] {
        publish_adv_text_layout(0x1)
        if G[0x306d] >= 0x0 {
            publish_adv_text_layout(0x9)
        }
    }
    return
}
@guard sub draw_speaker_name {
    G[0xfd41a] = get_message_glyph_delay()
    set_message_glyph_delay(0x0)
    show_text(0x9, unit_speaker_names[G[0x306d]][G[0x306f]])
    set_message_glyph_delay(G[0xfd41a])
    return
}
