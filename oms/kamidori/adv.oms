    draw_texture(0xcf08, 0x3, 0x0, 0x0, 0x400, 0x240, 0x0, 0x0)
    gfx_draw_color(0xcf08, 0x0, 0xff, 0x0)
    G[0x313f] = 0xff
    G[0x313e] = 0x0
    G[0x313d] = 0x0
    if 0x1 {
