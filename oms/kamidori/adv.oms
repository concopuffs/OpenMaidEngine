@guard sub show_speaker {
    atomic {
        append_text_history_metadata(0x2, G[0x306d])
        append_text_history_metadata(0x3, G[0x306f])
        if G[0xf5cb3][G[0x306d]] == 0x0 && G[0x306f] < 0x2 {
            G[0xf5cb3][G[0x306d]] = 0x1
            store_shared_profile_int(G[0xf5cb3][G[0x306d]])
        }
        draw_nameplate()
        apply_speaker_text_style()
        set_text_history_recording(0x0)
        draw_speaker_name()
        set_text_history_recording(0x1)
        set_adv_text_cursor(0x1, 0x3f - 0x17, 0x1c)
    }
    return
}
