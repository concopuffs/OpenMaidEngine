    がたいのいい工匠 = 0x7b
    無口な男 = 0x7c
    身なりのいい商人 = 0x7d
    カレンリの工匠 = 0x7e
    暗殺者 = 0x7f
    忍び = 0x80
    ガンツ = 0x81
    遠方の薬剤師 = 0x83
    マーズテリア騎士 = 0x97
    ダークエルフ = 0x12f
    トロウル = 0x174
    グロウトロウル = 0x176
    speaker_0x197 = 0x197  // レニア・ヌイ
    speaker_0x198 = 0x198  // ラクス・レニア
}

// Which column of unit_speaker_names the name plate shows (G[0x306f]).
enum name_form {
    form_name = 0x0
    form_alternate = 0x1
    form_descriptor = 0x2
    form_unknown = 0x4  // ？？？？
}

// One ADV page (spec §11.2). G[0x306e]: the page has text; G[0x306d]: the current speaker (-1 for narration).
@dialogue inline line(text: text, speaker: speaker = none, voice: const = none, form: name_form = 0x0) {
    set_tick_presentation(0x0)
    set_text_history_recording(0x0)
    reset_adv_text_layout(0x9)
    set_text_history_recording(0x1)
    reset_adv_text_layout(0x1)
    G[0x306e] = 0x1
    begin_page_voice()
    static if speaker == none {
        atomic {
            clear_speaker()
            arm_voice_duck_release()
            set_tick_presentation(0x1)
        }
    } else {
        atomic {
            G[0x306d] = speaker
            G[0x306f] = form
            show_speaker()
            set_tick_presentation(0x1)
        }
        static if voice != none {
            if G[0x306d] < 0x0 {
                mute_next_voice()
            } else if voice_suppressed[unit_voice_setting_slot[unit_voice_family_unit_ids[G[0x306d]]]] {
                mute_next_voice()
            }
            play_voice(voice)
        }
    }
    show_text(0x0, text)
    wait_for_input(0x0)
    end_text_line(0x0)
}

// The scene header's hotspot handlers: placed where each scene registers them, so the sidecar records their place.
sub register_adv_hotspots {
    atomic {
        if G[0x4fb] {
            register_hotspot_callbacks(0x300, 0x196, 0x1c, 0x18, history_button_enter, history_button_leave, history_button_click)
            register_hotspot_callbacks(0x31c, 0x196, 0x1c, 0x18, auto_button_enter, auto_button_leave, auto_button_click)
            register_hotspot_callbacks(0x338, 0x196, 0x1c, 0x18, skip_button_enter, skip_button_leave, skip_button_click)
            register_hotspot_callbacks(0x354, 0x196, 0x1c, 0x18, read_skip_button_enter, read_skip_button_leave, read_skip_button_click)
            register_hotspot_callbacks(0x370, 0x196, 0x1c, 0x18, hide_button_enter, hide_button_leave, hide_button_click)
        }
        register_hotspot_callbacks(-(0x3e8), -(0x3e8), 0x1, 0x1, -1, -1, cursor_key_0)
        register_hotspot_callbacks(-(0x3e8), -(0x3e9), 0x1, 0x1, -1, -1, cursor_key_1)
        register_hotspot_callbacks(-(0x3e8), -(0x3ea), 0x1, 0x1, -1, -1, cursor_key_2)
        register_hotspot_callbacks(-(0x3e8), -(0x3eb), 0x1, 0x1, -1, -1, cursor_key_3)
        register_hotspot_callbacks(-(0x3e8), -(0x3f0), 0x1, 0x1, -1, -1, cursor_key_8)
        bind_hotspot_key(-(0x3e8), -(0x3e8), 0x1, 0x1, 0x0)
        bind_hotspot_key(-(0x3e8), -(0x3e9), 0x1, 0x1, 0x1)
        bind_hotspot_key(-(0x3e8), -(0x3ea), 0x1, 0x1, 0x2)
        bind_hotspot_key(-(0x3e8), -(0x3eb), 0x1, 0x1, 0x3)
        bind_hotspot_key(-(0x3e8), -(0x3f0), 0x1, 0x1, 0x8)
        if G[0xfd41d] >= 0x0 {
            register_hotspot_callbacks(-(0x3e8), -(0x3ef), 0x1, 0x1, -1, -1, cursor_key_0_7)
            bind_hotspot_key(-(0x3e8), -(0x3ef), 0x1, 0x1, 0x7)
        }
        arm_hotspot_wait()
    }
    return
}
sub history_button_enter {
    atomic {
        G[0x503] = 0x1
        G[0xfd419] = 0x1
        draw_message_window()
    }
    return
}
sub history_button_leave {
    atomic {
        G[0x503] = 0x0
        G[0xfd419] = 0x0
        draw_message_window()
    }
    return
}
sub history_button_click {
    atomic {
        G[0x503] = 0x0
        draw_message_window()
    }
    cancel_hotspot_wait()
    run HISTORY
    register_adv_hotspots()
    return
}
sub auto_button_enter {
    atomic {
        G[0x504] = 0x1
        G[0xfd419] = 0x2
        draw_message_window()
    }
    return
}
sub auto_button_leave {
    atomic {
        G[0x504] = 0x0
        G[0xfd419] = 0x0
        draw_message_window()
    }
    return
}
sub auto_button_click {
    atomic {
        G[0x4ff] = get_auto_message()
        G[0x4ff] = 0x1 - G[0x4ff]
        set_auto_message(G[0x4ff])
        draw_message_window()
    }
    return
}
sub skip_button_enter {
    atomic {
        G[0x505] = 0x1
        G[0xfd419] = 0x3
        draw_message_window()
    }
    return
}
sub skip_button_leave {
    atomic {
        G[0x505] = 0x0
        G[0xfd419] = 0x0
        draw_message_window()
    }
    return
}
sub skip_button_click {
    atomic {
        G[0x505] = 0x0
        set_message_skip(0x1)
        draw_message_window()
        set_anim_clock(0x64)
        mark_frame_yield()
        reset_message_skip_input()
    }
    return
}
sub read_skip_button_enter {
    atomic {
        G[0x506] = 0x1
        G[0xfd419] = 0x4
        draw_message_window()
    }
    return
}
sub read_skip_button_leave {
    atomic {
        G[0x506] = 0x0
        G[0xfd419] = 0x0
        draw_message_window()
    }
    return
}
sub read_skip_button_click {
    atomic {
        G[0x506] = 0x0
        G[0xfd415] = get_read_message_skip()
        G[0xfd415] = 0x1 - G[0xfd415]
        set_read_message_skip(G[0xfd415])
        draw_message_window()
        set_anim_clock(0x64)
        mark_frame_yield()
        reset_message_skip_input()
    }
    return
}
sub hide_button_enter {
    atomic {
        G[0x507] = 0x1
        G[0xfd419] = 0x5
        draw_message_window()
    }
    return
}
sub hide_button_leave {
    atomic {
        G[0x507] = 0x0
        G[0xfd419] = 0x0
        draw_message_window()
    }
    return
}
sub hide_button_click {
    atomic {
        G[0x507] = 0x0
        draw_message_window()
    }
    yield_adv_coroutine()
    cancel_hotspot_wait()
    register_adv_hotspots()
    return
}
sub cursor_key_0 {
    if G[0x4fb] {
        if G[0x503] | G[0x504] | G[0x505] | G[0x506] | G[0x507] {
            get_cursor_virtual(out G[0x501], out G[0x502])
            set_cursor_virtual(G[0x501], 0x18c)
        } else {
            goto cursor_key_8
        }
    } else {
        goto cursor_key_8
    }
    return
cursor_key_1:
    if G[0x4fb] {
        if G[0x503] {
            get_cursor_virtual(out G[0x501], out G[0x502])
            set_cursor_virtual(0x32a, G[0x502])
            goto cursor_key_0_2
        }
        if G[0x504] {
            get_cursor_virtual(out G[0x501], out G[0x502])
            set_cursor_virtual(0x346, G[0x502])
            goto cursor_key_0_2
        }
        if G[0x505] {
            get_cursor_virtual(out G[0x501], out G[0x502])
            set_cursor_virtual(0x362, G[0x502])
            goto cursor_key_0_2
        }
        if G[0x506] {
            get_cursor_virtual(out G[0x501], out G[0x502])
            set_cursor_virtual(0x37e, G[0x502])
            goto cursor_key_0_2
        }
        if G[0x507] {
            get_cursor_virtual(out G[0x501], out G[0x502])
            set_cursor_virtual(0x39a, G[0x502])
            goto cursor_key_0_2
        }
        set_cursor_virtual(0x30e, 0x1a2)
    }
cursor_key_0_2:
    return
cursor_key_2:
    if G[0x4fb] {
        if G[0x503] | G[0x504] | G[0x505] | G[0x506] | G[0x507] {
            get_cursor_virtual(out G[0x501], out G[0x502])
            set_cursor_virtual(G[0x501], G[0x502] + G[0x500] * 0x2 - 0x1)
            G[0x500] = 0x1 - G[0x500]
            goto cursor_key_0_4
        }
        set_cursor_virtual(0x30e, 0x1a2)
    }
cursor_key_0_4:
    return
cursor_key_3:
    if G[0x4fb] {
        if G[0x503] {
            get_cursor_virtual(out G[0x501], out G[0x502])
            set_cursor_virtual(0x2f2, G[0x502])
            goto cursor_key_0_6
        }
        if G[0x504] {
            get_cursor_virtual(out G[0x501], out G[0x502])
            set_cursor_virtual(0x30e, G[0x502])
            goto cursor_key_0_6
        }
        if G[0x505] {
            get_cursor_virtual(out G[0x501], out G[0x502])
            set_cursor_virtual(0x32a, G[0x502])
            goto cursor_key_0_6
        }
        if G[0x506] {
            get_cursor_virtual(out G[0x501], out G[0x502])
            set_cursor_virtual(0x346, G[0x502])
            goto cursor_key_0_6
        }
        if G[0x507] {
            get_cursor_virtual(out G[0x501], out G[0x502])
            set_cursor_virtual(0x362, G[0x502])
            goto cursor_key_0_6
        }
        set_cursor_virtual(0x37e, 0x1a2)
    }
cursor_key_0_6:
    return
cursor_key_0_7:
    atomic {
        G[0x503] = 0x0
        G[0x504] = 0x0
        G[0x505] = 0x0
        G[0x506] = 0x0
        G[0x507] = 0x0
        cancel_hotspot_wait()
    }
    if G[0xfd41d] {
        GS[0x2263][G[0x136f85]] = set_string("シーン回想終了")
        G[0x136f87][G[0x136f85]] = G[0x136f85]
        G[0x13712c] = G[0x136f85]
        G[0x136f85] += 0x1
        GS[0x2263][G[0x136f85]] = set_string("キャンセル")
        G[0x136f87][G[0x136f85]] = G[0x136f85]
        G[0x13712c] = G[0x136f85]
        G[0x136f85] += 0x1
        G[0x13712d] = 0x7
        run BUNKI
        if G[0x136f86] == 0x0 {
            exit
        }
    } else {
        run MENU
    }
    register_adv_hotspots()
    return
cursor_key_8:
    atomic {
        G[0x503] = 0x0
        G[0x504] = 0x0
        G[0x505] = 0x0
        G[0x506] = 0x0
        G[0x507] = 0x0
        cancel_hotspot_wait()
    }
    run HISTORY
    register_adv_hotspots()
    return
}
coroutine adv_hide_window_handler {
    begin_window_transition()
    G[0x4f9] = 0x1
    draw_message_window()
    draw_nameplate()
    G[0x4f9] = 0x0
    G[0xfd45e] = 0x1f4
    fade_message_window()
    G[0xfd462] = 0x1
    present_window_transition()
    cancel_hotspot_wait()
    run HIDEWIN
    if G[0xfd420] {
        atomic {
            redraw_message_window()
            present_frame()
            G[0xfd420] = 0x0
        }
    }
    coroutine_save_yield_handlers(adv_hide_window_handler, adv_show_window_handler)
    register_adv_hotspots()
    mark_save_resume_frame()
    yield_adv_coroutine()
    resume
}
coroutine adv_show_window_handler {
    begin_window_transition()
    G[0x4f9] = 0x1
    draw_message_window()
    draw_nameplate()
    G[0x4f9] = 0x1
    G[0xfd45e] = 0x1f4
    fade_message_window()
    G[0xfd462] = 0x1
    G[0x306e] = 0x1
    present_window_transition()
    atomic {
        step_text_history(out G[0xfd412], out G[0xfd413], 0x0)
        find_text_history_value(out G[0x4f8], out G[0xfd411], G[0xfd412], G[0xfd413], 0x2)
        if G[0x4f8] {
            G[0x306d] = G[0xfd411]
            find_text_history_value(out G[0x4f8], out G[0x306f], G[0xfd412], G[0xfd413], 0x3)
            draw_nameplate()
            apply_speaker_text_style()
            publish_adv_text_layout(0x9)
        }
    }
    resume
}

// Library functions: linked after the scene behind an exit guard, breadth first in order of first reference.
@guard sub draw_message_window {
    gfx_elem_erase(0xd2f0, 0x2)
    gfx_elem_erase(0xd3b8, 0xe)
    if G[0x4f9] {
        if G[0x3223] & 0x2 {
            draw_texture(0xd2f0, 0x11, 0x0, 0x6d, 0x341, 0x6c, 0x60, 0x1b5)
        } else {
            draw_texture(0xd2f0, 0x11, 0x0, 0x0, 0x341, 0x6c, 0x60, 0x1b5)
        }
        G[0x4fd] = get_message_window_alpha()
        G[0xfd418] = 0x10 - G[0x4fd] << 0x4
        gfx_draw_color(0xd2f0, 0x0, G[0xfd418], G[0x3222])
        if G[0x3223] & 0x1 {
            draw_texture(0xd2f0 + 0x1, 0x11, 0x0, 0xda, 0x349, 0x74, 0x5c, 0x1b1)
        }
        if G[0x4fb] {
            for G[0xfd42d] = 0x0; G[0xfd42d] < 0x5; G[0xfd42d] += 0x1 {
                draw_texture(0xd3b8 + 0x1 + G[0xfd42d], 0x11, 0x1df, 0x14f, 0x1c, 0x18, 0x300 + G[0xfd42d] * 0x1c, 0x196)
                gfx_draw_color(0xd3b8 + 0x1 + G[0xfd42d], 0x0, G[0xfd418] / 0x2, G[0x3222])
                draw_texture(0xd3b8 + 0x6 + G[0xfd42d], 0x11, 0x14e + G[0xfd42d] * 0x1d, 0x14f, 0x1c, 0x18, 0x300 + G[0xfd42d] * 0x1c, 0x196)
                gfx_draw_color(0xd3b8 + 0x6 + G[0xfd42d], 0x0, 0x80, 0xffffff)
            }
            G[0x4f8] = get_auto_message()
            if G[0x4f8] {
                draw_texture(0xd3b8 + 0xb, 0x11, 0x1fc, 0x14f, 0x12, 0x8, 0x321, 0x1a6)
            }
            G[0x4f8] = op_0x19a()
            if G[0x4f8] {
                draw_texture(0xd3b8 + 0xc, 0x11, 0x1fc, 0x14f, 0x12, 0x8, 0x33d, 0x1a6)
            }
            G[0x4f8] = get_read_message_skip()
            if G[0x4f8] {
                draw_texture(0xd3b8 + 0xd, 0x11, 0x1fc, 0x14f, 0x12, 0x8, 0x359, 0x1a6)
            }
            if G[0x503] {
                draw_texture(0xd3b8, 0x11, 0x233, 0x1a7, 0xdc, 0x14, 0x224, 0x198)
                gfx_draw_color(0xd3b8 + 0x1, 0x0, G[0xfd418], G[0x3222])
                gfx_draw_color(0xd3b8 + 0x6, 0x0, 0xff, 0xffffff)
            }
            if G[0x504] {
                G[0x4f8] = get_auto_message()
                draw_texture(0xd3b8, 0x11, 0x233 - G[0x4f8] * 0xdd, 0x192, 0xdc, 0x14, 0x224, 0x198)
                gfx_draw_color(0xd3b8 + 0x2, 0x0, G[0xfd418], G[0x3222])
                gfx_draw_color(0xd3b8 + 0x7, 0x0, 0xff, 0xffffff)
            }
            if G[0x505] {
                G[0x4f8] = op_0x19a()
                draw_texture(0xd3b8, 0x11, 0x233 - G[0x4f8] * 0xdd, 0x17d, 0xdc, 0x14, 0x224, 0x198)
                gfx_draw_color(0xd3b8 + 0x3, 0x0, G[0xfd418], G[0x3222])
                gfx_draw_color(0xd3b8 + 0x8, 0x0, 0xff, 0xffffff)
            }
            if G[0x506] {
                G[0x4f8] = get_read_message_skip()
                draw_texture(0xd3b8, 0x11, 0x233 - G[0x4f8] * 0xdd, 0x168, 0xdc, 0x14, 0x224, 0x198)
