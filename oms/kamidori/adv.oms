oms 1
// Kamidori ADV prelude (spec §11.2): the scene library every ADV scene links, the dialogue line template and the
// speaker table. Drafted 2026-10-07 from the decompiled library of SC0010 (copies in 300+ scenes are identical)
// and the init image's unit_speaker_names (CNINIT); sub names describe behavior, maintained by hand since.
module kamidori.adv
use kamidori.globals
use kamidori.scripts

// Speaker ids: rows of unit_speaker_names (name form 0). Names that are not identifiers and repeated names carry
// their id.
enum speaker {
    ウィル = 0x1
    ユエラ = 0x2
    エミリッタ = 0x3
    セラウィ = 0x4
    レグナー = 0x5
    ロサナ = 0x6
    ジェーン = 0x7
    ティアン = 0x8
    ハンナ = 0x9
    ウィル_0xa = 0xa  // ウィル
    アト = 0xb
    水那 = 0xc
    サエラブ = 0xd
    クレール = 0xe
    メロディアーナ = 0xf
    シャルティ = 0x10
    アト_0x11 = 0x11  // アト
    水那_0x12 = 0x12  // 水那
    サエラブ_0x13 = 0x13  // サエラブ
    クレアンヌ = 0x14
    パラスケヴァス = 0x15
    狐伯蓮 = 0x16
    ガプタール = 0x17
    エリザスレイン = 0x18
    ラグスムエナ = 0x19
    クレール_0x1a = 0x1a  // クレール
    メロディアーナ_0x1b = 0x1b  // メロディアーナ
    シャルティ_0x1c = 0x1c  // シャルティ
    クレアンヌ_0x1d = 0x1d  // クレアンヌ
    パラスケヴァス_0x1e = 0x1e  // パラスケヴァス
    狐伯蓮_0x1f = 0x1f  // 狐伯蓮
    ガプタール_0x20 = 0x20  // ガプタール
    エリザスレイン_0x21 = 0x21  // エリザスレイン
    ラグスムエナ_0x22 = 0x22  // ラグスムエナ
    アト_0x24 = 0x24  // アト
    ハンナ_0x27 = 0x27  // ハンナ
    ロカ = 0x28
    リフィア = 0x29
    エヴリーヌ = 0x2a
    パイモン = 0x2b
    ハンナ_0x2c = 0x2c  // ハンナ
    リリィ = 0x2d
    レグナー_0x2e = 0x2e  // レグナー
    ストーンゴーレム = 0x2f
    リリィ_0x30 = 0x30  // リリィ
    リリィ_0x31 = 0x31  // リリィ
    ミレーヌ = 0x32
    フィニリィ = 0x33
    アスモデウス = 0x34
    エウシュリーちゃん = 0x3c
    ブラックエウシュリーちゃん = 0x3d
    アナスタシア = 0x3e
    エウクレイアさん = 0x40
    ユイドラ兵士 = 0x46
    ユイドラ兵士_0x47 = 0x47  // ユイドラ兵士
    ディスナフロディ兵 = 0x48
    speaker_0x49 = 0x49  // ディ・ファンダオ将軍
    東方の男 = 0x4a
    太った工匠 = 0x4b
    浅黒い工匠 = 0x4c
    鍛冶自慢の工匠 = 0x4d
    義手の工匠 = 0x4e
    工匠会幹部 = 0x4f
    明るい男の子 = 0x50
    やんちゃな男の子 = 0x51
    可愛らしい女の子 = 0x52
    元気な女の子 = 0x53
    若い女 = 0x54
    素朴な女 = 0x55
    声の大きな主婦 = 0x56
    クレドリアムス = 0x57
    ディスナ帝 = 0x58
    漁師 = 0x59
    東方の男_0x5a = 0x5a  // 東方の男
    太った男 = 0x5b
    浅黒い男 = 0x5c
    がたいのいい男 = 0x5d
    義手の男 = 0x5e
    身なりのいい男 = 0x5f
    明るい男の子_0x60 = 0x60  // 明るい男の子
    やんちゃな男の子_0x61 = 0x61  // やんちゃな男の子
    可愛らしい女の子_0x62 = 0x62  // 可愛らしい女の子
    元気な女の子_0x63 = 0x63  // 元気な女の子
    若い女_0x64 = 0x64  // 若い女
    素朴な女_0x65 = 0x65  // 素朴な女
    派手めな女 = 0x66
    使用人 = 0x67
    エルフの長 = 0x6e
    トキヤ国宿将 = 0x6f
    トキヤ軍部隊長 = 0x70
    ソフ軍兵士 = 0x71
