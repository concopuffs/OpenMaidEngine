// One ADV page (spec §11.2). G[0x3233]: the page has text; G[0x2e47]: keep the previous voice once;
// G[0x3232]: the current speaker (-1 for narration).
@dialogue inline line(text: text, speaker: speaker = none, voice: const = none) {
    reset_adv_text_layout(0x1)
    G[0x3233] = 0x1
    atomic {
        if G[0x2e47] == 0x0 {
            reset_message_voice_state()
        }
        G[0x2e47] = 0x0
        set_tick_presentation(0x1)
    }
    static if speaker == none {
        atomic {
            clear_speaker()
            arm_voice_duck_release()
        }
    } else {
        atomic {
            append_text_history_metadata(0x2, speaker)
            G[0x3232] = speaker
            if unit_story_speaker_seen_flags[G[0x3232]] == 0x0 {
                unit_story_speaker_seen_flags[G[0x3232]] = 0x1
                store_shared_profile_int(unit_story_speaker_seen_flags[G[0x3232]])
            }
            create_texture(0xd, 0x190, 0x1e, 0x0)
            draw_string(0xd, 0x1, 0x1, unit_story_display_names[G[0x3232]])
            draw_texture(0xe678, 0xd, 0x0, 0x0, 0x190, 0x1e, 0x4a, 0x1bc)
            set_adv_text_cursor(0x1, 0x64 - 0x19, 0x2f)
        }
        static if voice != none {
            if G[0x3232] < 0x0 {
                mute_next_voice()
            } else if character_voice_suppressed[unit_voice_suppression_flag_ids[unit_voice_family_unit_ids[G[0x3232]]]] {
                mute_next_voice()
            }
            play_voice(voice)
        }
    }
    show_text(0x0, text)
    end_text_line(0x0)
    wait_for_input(0x0)
    end_text_line(0x0)
}

// The scene header's hotspot handlers: placed where each scene registers them, so the sidecar records their place.
sub register_adv_hotspots {
    atomic {
        if adv_chrome_enabled {
            register_hotspot_callbacks(0x2ac, 0x23c, 0x14, 0x14, history_button_enter, history_button_leave, history_button_click)
            register_hotspot_callbacks(0x2c2, 0x23c, 0x14, 0x14, auto_button_enter, auto_button_leave, auto_button_click)
            register_hotspot_callbacks(0x2d8, 0x23c, 0x14, 0x14, skip_button_enter, skip_button_leave, skip_button_click)
            register_hotspot_callbacks(0x2ee, 0x23c, 0x14, 0x14, read_skip_button_enter, read_skip_button_leave, read_skip_button_click)
            register_hotspot_callbacks(0x304, 0x23c, 0x14, 0x14, hide_button_enter, hide_button_leave, hide_button_click)
        }
        register_hotspot_callbacks(-(0x3e8), -(0x3e8), 0x1, 0x1, -1, -1, history_hotkey)
        register_hotspot_callbacks(-(0x3e8), -(0x3f0), 0x1, 0x1, -1, -1, history_hotkey)
        bind_hotspot_key(-(0x3e8), -(0x3e8), 0x1, 0x1, 0x0)
        bind_hotspot_key(-(0x3e8), -(0x3f0), 0x1, 0x1, 0x8)
        if G[0x62426] == 0x0 && G[0x624bd] == 0x0 {
            register_hotspot_callbacks(-(0x3e8), -(0x3ef), 0x1, 0x1, -1, -1, menu_hotkey)
            bind_hotspot_key(-(0x3e8), -(0x3ef), 0x1, 0x1, 0x7)
        }
        arm_hotspot_wait()
    }
    return
}
sub history_button_enter {
    atomic {
        adv_hover_history = 0x1
        draw_message_window()
    }
    return
}
sub history_button_leave {
    atomic {
        adv_hover_history = 0x0
        draw_message_window()
    }
    return
}
sub history_button_click {
    atomic {
        adv_hover_history = 0x0
        draw_message_window()
    }
    cancel_hotspot_wait()
    G[0x62428] = 0x1
    run HISTORY
    coroutine_save_yield_handlers(adv_hide_window_handler, adv_show_window_handler)
    register_adv_hotspots()
    atomic {
        G[0x62428] = 0x0
        if G[0x62429] {
            draw_message_window()
            draw_nameplate()
            present_frame()
            G[0x62429] = 0x0
        }
    }
    mark_save_resume_frame()
    return
}
sub auto_button_enter {
    atomic {
        adv_hover_auto_message = 0x1
        draw_message_window()
    }
    return
}
sub auto_button_leave {
    atomic {
        adv_hover_auto_message = 0x0
        draw_message_window()
    }
    return
}
sub auto_button_click {
    atomic {
        G[0x6c5] = get_auto_message()
        G[0x6c5] += 0x1
        G[0x6c5] %= 0x2
        set_auto_message(G[0x6c5])
        draw_message_window()
        sleep(0x64)
        get_cursor_virtual(out G[0x6c7], out G[0x6c8])
        set_cursor_virtual(G[0x6c7], G[0x6c8] + G[0x6c6] * 0x2 - 0x1)
        G[0x6c6] = 0x1 - G[0x6c6]
        reset_message_skip_input()
    }
    return
}
sub skip_button_enter {
    atomic {
        adv_hover_message_skip = 0x1
        draw_message_window()
    }
    return
}
sub skip_button_leave {
    atomic {
        adv_hover_message_skip = 0x0
        draw_message_window()
    }
    return
}
sub skip_button_click {
    atomic {
        adv_hover_message_skip = 0x0
        set_message_skip(0x1)
        draw_message_window()
        sleep(0x64)
        get_cursor_virtual(out G[0x6c7], out G[0x6c8])
        set_cursor_virtual(G[0x6c7], G[0x6c8] + G[0x6c6] * 0x2 - 0x1)
        G[0x6c6] = 0x1 - G[0x6c6]
        reset_message_skip_input()
    }
    return
}
sub read_skip_button_enter {
    atomic {
        adv_hover_read_message_skip = 0x1
        draw_message_window()
    }
    return
}
sub read_skip_button_leave {
    atomic {
        adv_hover_read_message_skip = 0x0
        draw_message_window()
    }
    return
}
sub read_skip_button_click {
    atomic {
        adv_hover_read_message_skip = 0x0
        G[0x62420] = get_read_message_skip()
        G[0x62420] = 0x1 - G[0x62420]
        set_read_message_skip(G[0x62420])
        draw_message_window()
        sleep(0x64)
        get_cursor_virtual(out G[0x6c7], out G[0x6c8])
        set_cursor_virtual(G[0x6c7], G[0x6c8] + G[0x6c6] * 0x2 - 0x1)
        G[0x6c6] = 0x1 - G[0x6c6]
        reset_message_skip_input()
    }
    return
}
sub hide_button_enter {
    atomic {
        adv_hover_hide_window = 0x1
        draw_message_window()
    }
    return
}
sub hide_button_leave {
    atomic {
        adv_hover_hide_window = 0x0
        draw_message_window()
    }
    return
}
sub hide_button_click {
    atomic {
        adv_hover_hide_window = 0x0
        draw_message_window()
        yield_adv_coroutine()
        sleep(0x64)
        get_cursor_virtual(out G[0x6c7], out G[0x6c8])
        set_cursor_virtual(G[0x6c7], G[0x6c8] + G[0x6c6] * 0x2 - 0x1)
        G[0x6c6] = 0x1 - G[0x6c6]
        reset_message_skip_input()
    }
    return
}
sub history_hotkey {
    atomic {
        adv_hover_history = 0x0
        adv_hover_auto_message = 0x0
        adv_hover_message_skip = 0x0
        adv_hover_read_message_skip = 0x0
        adv_hover_hide_window = 0x0
    }
    cancel_hotspot_wait()
    G[0x62428] = 0x1
    run HISTORY
    coroutine_save_yield_handlers(adv_hide_window_handler, adv_show_window_handler)
    register_adv_hotspots()
    atomic {
        G[0x62428] = 0x0
        if G[0x62429] {
            draw_message_window()
            draw_nameplate()
            present_frame()
            G[0x62429] = 0x0
        }
    }
    mark_save_resume_frame()
    return
}
sub menu_hotkey {
    atomic {
        adv_hover_history = 0x0
        adv_hover_auto_message = 0x0
        adv_hover_message_skip = 0x0
        adv_hover_read_message_skip = 0x0
        adv_hover_hide_window = 0x0
    }
    cancel_hotspot_wait()
    G[0x62428] = 0x1
    run MENU
    coroutine_save_yield_handlers(adv_hide_window_handler, adv_show_window_handler)
    register_adv_hotspots()
    atomic {
        G[0x62428] = 0x0
        if G[0x62429] {
            draw_message_window()
            draw_nameplate()
            present_frame()
            G[0x62429] = 0x0
        }
    }
    mark_save_resume_frame()
    return
}
coroutine adv_hide_window_handler {
    begin_window_transition()
    G[0x6bf] = 0x1
    draw_message_window()
    G[0x6bf] = 0x0
    G[0x624a0] = 0x1f4
    fade_message_window()
    G[0x624a1] = 0x1
    present_window_transition()
    if adv_hide_window_enabled {
        cancel_hotspot_wait()
        G[0x62428] = 0x1
        run HIDEWIN
        coroutine_save_yield_handlers(adv_hide_window_handler, adv_show_window_handler)
        register_adv_hotspots()
        atomic {
            G[0x62428] = 0x0
            if G[0x62429] {
                draw_message_window()
                draw_nameplate()
                present_frame()
                G[0x62429] = 0x0
            }
        }
        mark_save_resume_frame()
        yield_adv_coroutine()
    }
    resume
}
coroutine adv_show_window_handler {
    begin_window_transition()
    G[0x6bf] = 0x1
    draw_message_window()
    G[0x6bf] = 0x1
    G[0x624a0] = 0x1f4
    fade_message_window()
    G[0x624a1] = 0x1
    G[0x3233] = 0x1
    present_window_transition()
    resume
}

// Library functions: linked after the scene behind an exit guard, breadth first in order of first reference.
@guard sub draw_message_window {
    gfx_elem_erase(0xd2f0, 0x7)
    if G[0x6bf] {
        draw_texture(0xd2f0, 0x11, 0x0, 0x0, 0x320, 0xe3, 0x0, 0x175)
        G[0x6c3] = get_message_window_alpha()
        gfx_draw_color(0xd2f0, 0x0, 0x10 - G[0x6c3] << 0x4, G[0x69d])
        if adv_chrome_enabled {
            draw_texture(0xd2f0 + 0x1, 0x11, 0x0, 0xfe, 0x72, 0x19, 0x2a9, 0x23a)
            G[0x6c5] = get_auto_message()
            if G[0x6c5] {
                draw_texture(0xd2f0 + 0x4, 0x11, 0x9a, 0xfe, 0x14, 0x14, 0x2c2, 0x23c)
            }
            G[0x6241f] = op_0x19a()
            if G[0x6241f] {
                draw_texture(0xd2f0 + 0x2, 0x11, 0xae, 0xfe, 0x14, 0x14, 0x2d8, 0x23c)
            }
            G[0x62420] = get_read_message_skip()
            if G[0x62420] {
                draw_texture(0xd2f0 + 0x3, 0x11, 0xc2, 0xfe, 0x14, 0x14, 0x2ee, 0x23c)
            }
            if adv_hover_history {
                draw_texture(0xd2f0 + 0x5, 0x11, 0x18c, 0xe3, 0x84, 0x1b, 0x223, 0x239)
                draw_texture(0xd2f0 + 0x6, 0x11, 0x72, 0xfe, 0x14, 0x14, 0x2ac, 0x23c)
                gfx_draw_color(0xd2f0 + 0x6, 0x1, 0x80, 0xffffff)
                goto draw_message_window_done
            }
            if adv_hover_auto_message {
                draw_texture(0xd2f0 + 0x5, 0x11, 0x108, 0xe3, 0x84, 0x1b, 0x223, 0x239)
                draw_texture(0xd2f0 + 0x6, 0x11, 0x72, 0xfe, 0x14, 0x14, 0x2c2, 0x23c)
                gfx_draw_color(0xd2f0 + 0x6, 0x1, 0x80, 0xffffff)
                goto draw_message_window_done
            }
            if adv_hover_message_skip {
                draw_texture(0xd2f0 + 0x5, 0x11, 0x0, 0xe3, 0x84, 0x1b, 0x223, 0x239)
                draw_texture(0xd2f0 + 0x6, 0x11, 0x72, 0xfe, 0x14, 0x14, 0x2d8, 0x23c)
                gfx_draw_color(0xd2f0 + 0x6, 0x1, 0x80, 0xffffff)
                goto draw_message_window_done
            }
            if adv_hover_read_message_skip {
                draw_texture(0xd2f0 + 0x5, 0x11, 0x84, 0xe3, 0x84, 0x1b, 0x223, 0x239)
                draw_texture(0xd2f0 + 0x6, 0x11, 0x72, 0xfe, 0x14, 0x14, 0x2ee, 0x23c)
                gfx_draw_color(0xd2f0 + 0x6, 0x1, 0x80, 0xffffff)
                goto draw_message_window_done
            }
            if adv_hover_hide_window {
                draw_texture(0xd2f0 + 0x5, 0x11, 0x210, 0xe3, 0x84, 0x1b, 0x223, 0x239)
                draw_texture(0xd2f0 + 0x6, 0x11, 0x72, 0xfe, 0x14, 0x14, 0x304, 0x23c)
                gfx_draw_color(0xd2f0 + 0x6, 0x1, 0x80, 0xffffff)
            }
        }
    }
draw_message_window_done:
    return
}
@guard sub draw_nameplate {
    gfx_elem_erase(0xd6d8, 0x1f4)
    gfx_elem_erase(0xe678, 0x1)
    if G[0x6bf] & G[0x3233] {
        publish_adv_text_layout(0x1)
        if G[0x3232] >= 0x0 {
            draw_texture(0xe678, 0xd, 0x0, 0x0, 0x190, 0x1e, 0x4a, 0x1bc)
        }
    }
    return
}
@guard sub begin_window_transition {
    atomic {
        G[0x62428] = 0x1
        return
        exit
    fade_message_window:
        if G[0x6bf] {
            G[0x6c3] = get_message_window_alpha()
            gfx_blit_color(0xd2f0, 0x0, G[0x624a0], 0x10 - G[0x6c3] << 0x4, G[0x69d])
            gfx_draw_color(0xd2f0, 0x0, 0x0, G[0x69d])
            for G[0x62451] = 0xd2f0 + 0x1; G[0x62451] <= 0xd2f0 + 0x5; G[0x62451] += 0x1 {
                adv_gfx_surface_slot_work = op_0x215(G[0x62451])
                if adv_gfx_surface_slot_work >= 0x0 {
                    gfx_blit_color(G[0x62451], 0x0, G[0x624a0], 0xff, 0xffffff)
                    gfx_draw_color(G[0x62451], 0x0, 0x0, 0xffffff)
                }
            }
            gfx_blit_color(G[0x62451], 0x0, G[0x624a0], 0x80, 0xffffff)
            gfx_draw_color(G[0x62451], 0x1, 0x0, 0xffffff)
            goto fade_message_window_done
        }
        gfx_blit_color(0xd2f0, 0x0, G[0x624a0], 0x0, G[0x69d])
        for G[0x62451] = 0xd2f0 + 0x1; G[0x62451] <= 0xd2f0 + 0x6; G[0x62451] += 0x1 {
            adv_gfx_surface_slot_work = op_0x215(G[0x62451])
            if adv_gfx_surface_slot_work >= 0x0 {
                gfx_blit_color(G[0x62451], 0x0, G[0x624a0], 0x0, 0xffffff)
            }
        }
    fade_message_window_done:
        gfx_elem_erase(0xd674, 0x1)
        clear_message_text()
        return
        exit
    present_window_transition:
        set_tick_presentation(0x1)
        if G[0x624a1] {
            G[0x624a1] = 0x0
            if G[0x624ba] {
                G[0x624bb] = 0x0
                for adv_gfx_layer_index = 0x0; adv_gfx_layer_index <= 0x7; adv_gfx_layer_index += 0x1 {
                    if G[0x624bb] < G[0x32b2][adv_gfx_layer_index] {
                        G[0x624bb] = G[0x32b2][adv_gfx_layer_index]
                    }
                }
                if G[0x624bb] {
                    set_anim_clock(G[0x624bb])
                }
                G[0x624ba] = 0x0
            }
            G[0x6241f] = op_0x1c7()
            G[0x62420] = get_adv_read_skip_state()
            if G[0x6241f] | G[0x62420] {
                reset_anim_clock()
                present_frame()
            } else {
                mark_frame_yield()
            }
            clear_gfx_command_queue()
            for adv_gfx_layer_index = 0x0; adv_gfx_layer_index <= 0x7; adv_gfx_layer_index += 0x1 {
                if adv_gfx_object_handles[adv_gfx_layer_index] {
                    adv_gfx_surface_slot_work = op_0x215(adv_gfx_object_handles[adv_gfx_layer_index] + 0x1)
                    if adv_gfx_surface_slot_work >= 0x0 {
                        gfx_elem_erase(adv_gfx_object_handles[adv_gfx_layer_index] + 0x1, 0x1)
                        gfx_elem_release(adv_gfx_surface_slot_work)
                    }
                    adv_gfx_surface_slot_work = op_0x215(adv_gfx_object_handles[adv_gfx_layer_index] + 0x2)
                    if adv_gfx_surface_slot_work >= 0x0 {
                        gfx_draw_color(adv_gfx_object_handles[adv_gfx_layer_index], 0x0, -(0x1), -(0x1))
                        gfx_elem_erase(adv_gfx_object_handles[adv_gfx_layer_index] + 0x2, 0x1)
                        gfx_elem_release(adv_gfx_surface_slot_work)
                    }
                }
            }
            if G[0x624a2] & 0x1 {
                gfx_elem_erase(0xd28c, 0x2)
                gfx_elem_release(0x1)
                gfx_elem_release(0x3b)
            }
            if G[0x624a2] & 0x2 {
                gfx_elem_erase(0xcf08 + 0x1, 0x1)
                gfx_elem_release(0x3c)
                if G[0x624ab] == 0x1 {
                    gfx_draw_color(0xcf08, G[0x32ee], 0x0, -(0x1))
                }
            }
            if G[0x624a2] & 0x4 {
                for adv_gfx_layer_index = 0x0; adv_gfx_layer_index <= 0x7; adv_gfx_layer_index += 0x1 {
                    if adv_gfx_object_handles[adv_gfx_layer_index] {
                        gfx_elem_erase(adv_gfx_object_handles[adv_gfx_layer_index] + 0x1, 0x1)
                        gfx_elem_release(adv_layer_surface_slots[adv_gfx_layer_index].transition_surface_slot)
                        if G[0x624a3][adv_gfx_layer_index] == 0x1 {
                            gfx_draw_color(adv_gfx_object_handles[adv_gfx_layer_index], 0x0, 0x0, -(0x1))
                        }
                    }
                }
            }
            G[0x624a2] = 0x0
            zero_int_range(G[0x624a3], 0x14)
            if G[0x624b7] {
                G[0x624b7] = 0x0
                set_gfx_range_transform(0x0, 0x0, 0x0, 0x0, 0x0)
            }
            draw_nameplate()
        }
        zero_int_range(G[0x32b2], 0x14)
        atomic {
            G[0x62428] = 0x0
            if G[0x62429] {
                draw_message_window()
                draw_nameplate()
                present_frame()
                G[0x62429] = 0x0
            }
        }
    }
    return
}
@guard sub init_adv_layer_slots {
    adv_layer_surface_slots = 0x4
    G[0x323a] = 0x2b
    G[0x323b] = 0x33
    G[0x323c] = 0x5
    G[0x323d] = 0x2c
    G[0x323e] = 0x34
    G[0x323f] = 0x6
    G[0x3240] = 0x2d
    G[0x3241] = 0x35
    G[0x3242] = 0x7
    G[0x3243] = 0x2e
    G[0x3244] = 0x36
    G[0x3245] = 0x8
    G[0x3246] = 0x2f
    G[0x3247] = 0x37
    G[0x3248] = 0x9
    G[0x3249] = 0x30
    G[0x324a] = 0x38
    G[0x324b] = 0xa
    G[0x324c] = 0x31
    G[0x324d] = 0x39
    G[0x324e] = 0xb
    G[0x324f] = 0x32
    G[0x3250] = 0x3a
    return
}
@guard sub clear_message_text {
    gfx_elem_erase(0xd6d8, 0x1f4)
    gfx_elem_erase(0xe678, 0x1)
    G[0x3233] = 0x0
    reset_message_voice_state()
    return
}
@guard sub show_layer_graphic {
    op_0x21a(adv_gfx_object_handles[adv_gfx_layer_index], out G[0x62498], out G[0x62499], out G[0x6249a])
    op_0x218(adv_gfx_object_handles[adv_gfx_layer_index], out G[0x6249b], out G[0x6249c], out G[0x6249d])
    adv_gfx_surface_slot_work = op_0x215(adv_gfx_object_handles[adv_gfx_layer_index])
    if adv_gfx_surface_slot_work < 0x0 {
        adv_gfx_surface_slot_work = adv_layer_surface_slots[adv_gfx_layer_index].primary_surface_slot
        G[0x6249b] = G[0x62469][adv_gfx_layer_index]
        G[0x6249c] = G[0x6247d][adv_gfx_layer_index]
        set_gfx_geom3(adv_gfx_object_handles[adv_gfx_layer_index], G[0x6249b], G[0x6249c], G[0x6249d])
    } else {
        get_texture_size(adv_gfx_surface_slot_work, out G[0x62453], out G[0x62454])
        G[0x6249b] = G[0x62498] + G[0x62453] / 0x2
        G[0x6249c] = G[0x62499] + G[0x62454]
    }
    set_texture(adv_gfx_resource_id, adv_gfx_surface_slot_work, -(0x1))
    get_texture_size(adv_gfx_surface_slot_work, out G[0x62453], out G[0x62454])
    G[0x62498] = G[0x6249b] - G[0x62453] / 0x2
    G[0x62499] = G[0x6249c] - G[0x62454]
    draw_texture(adv_gfx_object_handles[adv_gfx_layer_index], adv_gfx_surface_slot_work, 0x0, 0x0, G[0x62453], G[0x62454], G[0x62498], G[0x62499])
    set_object_animation_detached(adv_gfx_object_handles[adv_gfx_layer_index], 0x0)
    G[0x3276][adv_gfx_layer_index] = 0x0
    G[0x328a][adv_gfx_layer_index] = 0x0
    G[0x32b2][adv_gfx_layer_index] = 0x0
    return
}
@guard sub transition_background_and_show_window {
    begin_window_transition()
    if 0x0 {
        gfx_blit_color(0xcf08, 0x0, 0x4b0, -(0x1), -(0x1))
        gfx_draw_color(0xcf08, G[0x32ee], 0x0, -(0x1))
    } else {
        gfx_blit_color(0xcf08, 0x0, 0x4b0, 0x0, -(0x1))
    }
    G[0x624a1] = 0x1
    present_window_transition()
    begin_window_transition()
    G[0x6bf] = 0x1
    draw_message_window()
    G[0x6bf] = 0x1
    G[0x624a0] = 0x1f4
    fade_message_window()
    G[0x624a1] = 0x1
    present_window_transition()
    return
}
@guard sub clear_speaker {
    G[0x3232] = -(0x1)
    gfx_elem_erase(0xe678, 0x1)
    gfx_elem_release(0xd)
    return
}
@guard sub hide_message_window {
    begin_window_transition()
    G[0x6bf] = 0x1
    draw_message_window()
    G[0x6bf] = 0x0
    G[0x624a0] = 0x96
    fade_message_window()
    G[0x624a1] = 0x1
    present_window_transition()
    return
}
@guard sub show_message_window {
    begin_window_transition()
    G[0x6bf] = 0x1
    draw_message_window()
    G[0x6bf] = 0x1
    G[0x624a0] = 0x96
    fade_message_window()
    G[0x624a1] = 0x1
    present_window_transition()
    return
}
@guard sub crossfade_layer_graphic {
    adv_gfx_surface_slot_work = op_0x215(adv_gfx_object_handles[adv_gfx_layer_index])
    if adv_gfx_surface_slot_work < 0x0 {
        show_layer_graphic()
        gfx_blit_color(adv_gfx_object_handles[adv_gfx_layer_index], G[0x6249f], G[0x624a0], 0xff, 0xffffff)
        gfx_draw_color(adv_gfx_object_handles[adv_gfx_layer_index], 0x0, 0x0, 0xffffff)
    } else {
        gfx_draw_color(adv_gfx_object_handles[adv_gfx_layer_index], 0x2, -(0x1), -(0x1))
        clone_gfx_object(adv_gfx_object_handles[adv_gfx_layer_index], adv_gfx_object_handles[adv_gfx_layer_index] + 0x1)
        op_0x21a(adv_gfx_object_handles[adv_gfx_layer_index], out G[0x62498], out G[0x62499], out G[0x6249a])
        get_texture_size(adv_gfx_surface_slot_work, out G[0x62453], out G[0x62454])
        G[0x6249b] = G[0x62498] + G[0x62453] / 0x2
        G[0x6249c] = G[0x62499] + G[0x62454]
        if adv_gfx_surface_slot_work == adv_layer_surface_slots[adv_gfx_layer_index].primary_surface_slot {
            adv_gfx_surface_slot_work = adv_layer_surface_slots[adv_gfx_layer_index].alternate_surface_slot
        } else {
            adv_gfx_surface_slot_work = adv_layer_surface_slots[adv_gfx_layer_index].primary_surface_slot
        }
        set_texture(adv_gfx_resource_id, adv_gfx_surface_slot_work, -(0x1))
        get_texture_size(adv_gfx_surface_slot_work, out G[0x62453], out G[0x62454])
        G[0x62498] = G[0x6249b] - G[0x62453] / 0x2
        G[0x62499] = G[0x6249c] - G[0x62454]
        draw_texture(adv_gfx_object_handles[adv_gfx_layer_index], adv_gfx_surface_slot_work, 0x0, 0x0, G[0x62453], G[0x62454], G[0x62498], G[0x62499])
        gfx_elem_release(adv_layer_surface_slots[adv_gfx_layer_index].transition_surface_slot)
        queue_surface_alpha_transition(adv_gfx_object_handles[adv_gfx_layer_index] + 0x2, adv_layer_surface_slots[adv_gfx_layer_index].transition_surface_slot, adv_gfx_object_handles[adv_gfx_layer_index] + 0x1, 0x1, adv_gfx_object_handles[adv_gfx_layer_index], 0x1, G[0x6249f], G[0x624a0])
        draw_texture(adv_gfx_object_handles[adv_gfx_layer_index] + 0x2, adv_layer_surface_slots[adv_gfx_layer_index].transition_surface_slot, 0x0, 0x0, 0x320, 0x258, 0x0, 0x0)
    }
    return
}
@guard sub hide_window_and_fade_to_black {
    begin_window_transition()
    G[0x6bf] = 0x1
    draw_message_window()
    G[0x6bf] = 0x0
    G[0x624a0] = 0x1f4
    fade_message_window()
    G[0x624a1] = 0x1
    present_window_transition()
    begin_window_transition()
    draw_texture(0xcf08, 0x3, 0x0, 0x0, 0x320, 0x258, 0x0, 0x0)
    gfx_draw_color(0xcf08, 0x0, 0xff, 0x0)
    G[0x32ee] = 0x0
    if 0x1 {
        gfx_blit_color(0xcf08, 0x0, 0x4b0, -(0x1), -(0x1))
        gfx_draw_color(0xcf08, G[0x32ee], 0x0, -(0x1))
    } else {
        gfx_blit_color(0xcf08, 0x0, 0x4b0, 0x0, -(0x1))
    }
    G[0x624a1] = 0x1
    present_window_transition()
    return
}
