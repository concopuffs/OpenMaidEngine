    if 0x0 {
        set_polygon_color(0xa7f8, G[0x35fb], 0x0, G[0x35ff])
        fade_polygon_color(0xa7f8, 0x0, 0xf0, G[0x35fe], G[0x35ff])
        G[0x35fc] = G[0x35fe]
    } else {
        fade_polygon_color(0xa7f8, 0x0, 0xf0, 0x0, G[0x35ff])
        G[0x35fc] = 0x0
    }
    G[0x35fd] = G[0x35ff]
    G[0x3fbd1] = 0x1
    present_window_transition()
    begin_window_transition()
    if 0x1 {
        G[0x3140] = -(0x1)
        G[0x3145] = -(0x1)
        G[0x3146] = -(0x1)
    }
    G[0x5cc] = 0x1
    draw_message_window()
    draw_nameplate()
    G[0x5cc] = 0x1
    G[0x3fbcd] = 0x96
    fade_message_window()
    present_window_transition()
    return
}
@guard sub fade_to_black_490ms {
    begin_window_transition()
    GF[0x4] = mov_float(0x0)
