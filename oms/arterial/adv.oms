oms 1
// Arterial (創刻のアテリアル) ADV prelude (spec §11.2): the scene header's handlers, the library its scenes link
// and the dialogue line template. Drafted 2026-11-20 from the core decompile of every SC and SP scene: the
// header from SC0000 (279 of 282 scenes carry it unchanged), each library sub from the first scene that links
// it, as many copies as one scene carries. Sub names describe behaviour as read then; the families that differ
// only in a duration, a colour or whether the speaker is cleared carry those in their names. Maintained by
// hand since.
module arterial.adv
use arterial.scripts

// One ADV page (spec §11.2). G[0x3141]: the page has text. A speaker is given by a face picture: set_page_face
// looks the picture up for its character (G[0x3140], -1 for narration) and draws the name plate in the name form
// G[0x3143] (a column of the character's names; a value outside 0 to 5 shows ？？？？). G[0x3fb91] is the voice.
@dialogue inline line(text: text, face: const = none, voice: const = none, form: const = 0x0) {
    G[0x3141] = 0x1
    begin_page_voice()
    static if face == none {
        atomic {
            G[0x3146] = -(0x1)
            clear_speaker_face()
            clear_speaker()
            arm_voice_duck_release()
            set_tick_presentation(0x1)
        }
    } else {
        atomic {
            G[0x3143] = form
            G[0x3fb90] = face
            set_page_face()
            set_tick_presentation(0x1)
        }
    }
    static if voice != none {
        atomic {
            G[0x3fb86] = get_message_skip()
            G[0x3fb87] = get_adv_read_skip_state()
            if G[0x3fb86] | G[0x3fb87] {
                reset_message_voice_state()
                arm_voice_duck_release()
            }
            if G[0x3140] < 0x0 {
                set_voice_bgm_duck_control(0x10001)
                G[0x214809] = 0x2
                G[0x214808] = 0xd
            } else {
                set_voice_bgm_duck_control(0x0)
                G[0x214809] = G[0x29ee8e][G[0x3140]]
                G[0x214808] = G[0x297db9][G[0x3140]]
            }
            G[0x3fb91] = voice
            if G[0x214809] == 0x2 {
                append_text_history_metadata(0x4, G[0x214808])
                append_text_history_metadata(0x5, G[0x3fb91])
            }
            if G[0x214809] == 0x2 && G[0x2d57][G[0x2981a1][G[0x214808]]] == 0x0 {
                if G[0x3fb86] | G[0x3fb87] {
                    set_voice_bgm_duck_control(0x10001)
                    mute_next_voice()
                }
            } else {
                G[0x3fb91] = 0x0
            }
            if G[0x3fb91] {
                play_voice(G[0x3fb91])
            } else {
                arm_voice_duck_release()
            }
        }
    }
    show_text(0x0, text)
    wait_for_input(0x0)
    end_text_line(0x0)
    set_tick_presentation(0x0)
    reset_adv_text_layout(0x1)
}

// The scene header's hotspot handlers: placed where each scene registers them, so the sidecar records their place.
sub register_adv_hotspots {
    atomic {
        if G[0x5ce] {
            if G[0x3fb93] == 0x0 {
                register_hotspot_callbacks(0x243, 0x220, 0x2c, 0x11, quick_save_button_enter, quick_save_button_leave, quick_save_button_click)
                register_hotspot_callbacks(0x274, 0x220, 0x2c, 0x11, quick_load_button_enter, quick_load_button_leave, quick_load_button_click)
            }
            register_hotspot_callbacks(0x2af, 0x220, 0x2c, 0x11, history_button_enter, history_button_leave, history_button_click)
            register_hotspot_callbacks(0x2e0, 0x220, 0x2c, 0x11, auto_button_enter, auto_button_leave, auto_button_click)
            register_hotspot_callbacks(0x311, 0x220, 0x2c, 0x11, skip_button_enter, skip_button_leave, skip_button_click)
            register_hotspot_callbacks(0x342, 0x220, 0x2c, 0x11, read_skip_button_enter, read_skip_button_leave, read_skip_button_click)
            register_hotspot_callbacks(0x37d, 0x220, 0x18, 0x11, hide_button_enter, hide_button_leave, hide_button_click)
        }
        register_hotspot_callbacks(-(0x3e8), -(0x3e8), 0x1, 0x1, -1, -1, cursor_key_0)
        register_hotspot_callbacks(-(0x3e8), -(0x3e9), 0x1, 0x1, -1, -1, cursor_key_1)
        register_hotspot_callbacks(-(0x3e8), -(0x3ea), 0x1, 0x1, -1, -1, cursor_key_2)
        register_hotspot_callbacks(-(0x3e8), -(0x3eb), 0x1, 0x1, -1, -1, cursor_key_3)
        register_hotspot_callbacks(-(0x3e8), -(0x3f0), 0x1, 0x1, -1, -1, cursor_key_8)
        bind_hotspot_key(-(0x3e8), -(0x3e8), 0x1, 0x1, 0x0)
        bind_hotspot_key(-(0x3e8), -(0x3e9), 0x1, 0x1, 0x1)
        bind_hotspot_key(-(0x3e8), -(0x3ea), 0x1, 0x1, 0x2)
        bind_hotspot_key(-(0x3e8), -(0x3eb), 0x1, 0x1, 0x3)
        bind_hotspot_key(-(0x3e8), -(0x3f0), 0x1, 0x1, 0x8)
        if G[0x3fb93] >= 0x0 {
            register_hotspot_callbacks(-(0x3e8), -(0x3ef), 0x1, 0x1, -1, -1, cursor_key_7)
            bind_hotspot_key(-(0x3e8), -(0x3ef), 0x1, 0x1, 0x7)
        }
        arm_hotspot_wait()
    }
    return
}
sub quick_save_button_enter {
    atomic {
        G[0x5d6] = 0x1
        G[0x3fb8c] = 0x1
        draw_message_window()
    }
    return
}
sub quick_save_button_leave {
    atomic {
        G[0x5d6] = 0x0
        G[0x3fb8c] = 0x0
        draw_message_window()
    }
    return
}
sub quick_save_button_click {
    atomic {
        G[0x5d6] = 0x0
        G[0x3fb8e] = save_numbered_slot(0x3e7)
        G[0x5d6] = 0x1
        sfx_load(0x26, 0x1)
        sfx_start(0x1)
        draw_message_window()
    }
    return
}
sub quick_load_button_enter {
    atomic {
        G[0x5d7] = 0x1
        G[0x3fb8c] = 0x2
        draw_message_window()
    }
    return
}
sub quick_load_button_leave {
    atomic {
        G[0x5d7] = 0x0
        G[0x3fb8c] = 0x0
        draw_message_window()
    }
    return
}
sub quick_load_button_click {
    query_numbered_save_metadata(out G[0x3fb8e], 0x3e7, out G[0x3fb8f], out G[0x3fb8f], out G[0x3fb8f], out G[0x3fb8f], out G[0x3fb8f], out G[0x3fb8f], out G[0x3fb8f])
    if G[0x3fb8e] == 0x0 {
        sfx_load(0x26, 0x1)
        sfx_start(0x1)
        sleep(0x1f4)
        set_tick_presentation(0x0)
        suspend_adv_skip_service()
        note "savemesskip q-load"
        instruction_marker_noop()
        set_adv_wait_indicator_enabled(0x0)
        G[0x3fb8e] = load_numbered_slot_and_resume(0x3e7)
    }
    return
}
sub history_button_enter {
    atomic {
        G[0x5d8] = 0x1
        G[0x3fb8c] = 0x3
        draw_message_window()
    }
    return
}
sub history_button_leave {
