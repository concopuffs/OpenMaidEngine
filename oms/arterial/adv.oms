    op_0x21a(G[0x3fbad][G[0x3fba7]], out G[0x3fbc5], out G[0x3fbc6], out G[0x3fbc7])
    op_0x218(G[0x3fbad][G[0x3fba7]], out G[0x3fbc8], out G[0x3fbc9], out G[0x3fbca])
    get_texture_size(G[0x3fba9], out G[0x3fbaa], out G[0x3fbab])
