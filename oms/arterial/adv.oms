sub hide_button_click {
    atomic {
        G[0x5dc] = 0x0
        draw_message_window()
    }
    yield_adv_coroutine()
    cancel_hotspot_wait()
    register_adv_hotspots()
    return
}
sub cursor_key_0 {
    if G[0x5ce] {
        if G[0x5d6] | G[0x5d7] | G[0x5d8] | G[0x5d9] | G[0x5da] | G[0x5db] | G[0x5dc] {
            get_cursor_virtual(out G[0x5d4], out G[0x5d5])
            set_cursor_virtual(G[0x5d4], 0x215)
        } else {
            goto cursor_key_8
        }
    } else {
        goto cursor_key_8
    }
    return
cursor_key_1:
    if G[0x5ce] {
        if G[0x5d6] {
            get_cursor_virtual(out G[0x5d4], out G[0x5d5])
            set_cursor_virtual(0x28a, G[0x5d5])
            goto cursor_key_0_2
        }
        if G[0x5d7] {
            get_cursor_virtual(out G[0x5d4], out G[0x5d5])
            set_cursor_virtual(0x2c5, G[0x5d5])
            goto cursor_key_0_2
        }
        if G[0x5d8] {
            get_cursor_virtual(out G[0x5d4], out G[0x5d5])
            set_cursor_virtual(0x2f6, G[0x5d5])
            goto cursor_key_0_2
        }
        if G[0x5d9] {
            get_cursor_virtual(out G[0x5d4], out G[0x5d5])
            set_cursor_virtual(0x327, G[0x5d5])
            goto cursor_key_0_2
        }
        if G[0x5da] {
            get_cursor_virtual(out G[0x5d4], out G[0x5d5])
            set_cursor_virtual(0x358, G[0x5d5])
            goto cursor_key_0_2
        }
        if G[0x5db] {
            get_cursor_virtual(out G[0x5d4], out G[0x5d5])
            set_cursor_virtual(0x389, G[0x5d5])
            goto cursor_key_0_2
        }
        if G[0x5dc] {
            get_cursor_virtual(out G[0x5d4], out G[0x5d5])
            set_cursor_virtual(0x3a0, G[0x5d5])
            goto cursor_key_0_2
        }
        set_cursor_virtual(0x259, 0x229)
    }
cursor_key_0_2:
    return
cursor_key_2:
    if G[0x5ce] {
        if G[0x5d6] | G[0x5d7] | G[0x5d8] | G[0x5d9] | G[0x5da] | G[0x5db] | G[0x5dc] {
            get_cursor_virtual(out G[0x5d4], out G[0x5d5])
            set_cursor_virtual(G[0x5d4], G[0x5d5] + G[0x5d3] * 0x2 - 0x1)
            G[0x5d3] = 0x1 - G[0x5d3]
            goto cursor_key_0_4
        }
        set_cursor_virtual(0x259, 0x229)
    }
cursor_key_0_4:
    return
cursor_key_3:
    if G[0x5ce] {
        if G[0x5d6] {
            get_cursor_virtual(out G[0x5d4], out G[0x5d5])
            set_cursor_virtual(0x238, G[0x5d5])
            goto cursor_key_0_6
        }
        if G[0x5d7] {
            get_cursor_virtual(out G[0x5d4], out G[0x5d5])
            set_cursor_virtual(0x259, G[0x5d5])
            goto cursor_key_0_6
        }
        if G[0x5d8] {
            get_cursor_virtual(out G[0x5d4], out G[0x5d5])
            set_cursor_virtual(0x28a, G[0x5d5])
            goto cursor_key_0_6
        }
        if G[0x5d9] {
            get_cursor_virtual(out G[0x5d4], out G[0x5d5])
            set_cursor_virtual(0x2c5, G[0x5d5])
            goto cursor_key_0_6
        }
        if G[0x5da] {
            get_cursor_virtual(out G[0x5d4], out G[0x5d5])
            set_cursor_virtual(0x2f6, G[0x5d5])
            goto cursor_key_0_6
        }
        if G[0x5db] {
            get_cursor_virtual(out G[0x5d4], out G[0x5d5])
            set_cursor_virtual(0x327, G[0x5d5])
            goto cursor_key_0_6
        }
        if G[0x5dc] {
            get_cursor_virtual(out G[0x5d4], out G[0x5d5])
            set_cursor_virtual(0x358, G[0x5d5])
            goto cursor_key_0_6
        }
        set_cursor_virtual(0x389, 0x229)
    }
cursor_key_0_6:
    return
cursor_key_7:
    atomic {
        G[0x5d6] = 0x0
        G[0x5d7] = 0x0
        G[0x5d8] = 0x0
        G[0x5d9] = 0x0
        G[0x5da] = 0x0
        G[0x5db] = 0x0
        G[0x5dc] = 0x0
        cancel_hotspot_wait()
    }
    if G[0x3fb93] {
        GS[0xe8][G[0x214819]] = set_string("シーン回想終了")
        G[0x21481b][G[0x214819]] = G[0x214819]
        G[0x2149c0] = G[0x214819]
        G[0x214819] += 0x1
        GS[0xe8][G[0x214819]] = set_string("キャンセル")
        G[0x21481b][G[0x214819]] = G[0x214819]
        G[0x2149c0] = G[0x214819]
        G[0x214819] += 0x1
        G[0x2149c1] = 0x7
        run BUNKI
        if G[0x21481a] == 0x0 {
            exit
        }
    } else {
        G[0x3fba4] = 0x0
        run MENU
    }
    register_adv_hotspots()
    return
cursor_key_8:
    atomic {
        G[0x5d6] = 0x0
        G[0x5d7] = 0x0
        G[0x5d8] = 0x0
        G[0x5d9] = 0x0
        G[0x5da] = 0x0
        G[0x5db] = 0x0
        G[0x5dc] = 0x0
        cancel_hotspot_wait()
    }
    run HISTORY
    register_adv_hotspots()
    return
}
coroutine adv_hide_window_handler {
    begin_window_transition()
    G[0x5cc] = 0x0
    G[0x3fbcd] = 0x1f4
    fade_message_window()
    present_window_transition()
    cancel_hotspot_wait()
    run HIDEWIN
    if G[0x3fb96] {
        atomic {
            redraw_message_window()
            present_frame()
            G[0x3fb96] = 0x0
        }
    }
    coroutine_save_yield_handlers(adv_hide_window_handler, adv_show_window_handler)
    register_adv_hotspots()
    mark_save_resume_frame()
    yield_adv_coroutine()
    resume
}
coroutine adv_show_window_handler {
    begin_window_transition()
    G[0x5cc] = 0x1
    G[0x3fbcd] = 0x1f4
    fade_message_window()
    G[0x3141] = 0x1
    present_window_transition()
    resume
}

// Library functions: linked after the scene behind an exit guard, breadth first in order of first reference.
@guard sub draw_message_window {
    gfx_elem_erase(0xabe0, 0x2)
    gfx_elem_erase(0xad0c, 0xe)
    if G[0x5cc] {
        draw_texture(0xabe0, 0x11, 0x4d, 0x19b, 0x37a, 0x66, 0x43, 0x1c3)
        G[0x5d0] = get_message_window_alpha()
        G[0x3fb8b] = 0x10 - G[0x5d0] << 0x4
        gfx_draw_color(0xabe0, 0x0, G[0x3fb8b], G[0x36ea])
        draw_texture(0xabe0 + 0x1, 0x11, 0x4d, 0x12e, 0x37a, 0x6c, 0x43, 0x1c0)
        if G[0x5ce] {
            if G[0x3fb93] == 0x0 {
                draw_texture(0xad0c, 0x11, 0x71, 0x22e, 0x2c, 0x1b, 0x243, 0x21e)
                draw_texture(0xad0c + 0x1, 0x11, 0x9e, 0x22e, 0x2c, 0x1b, 0x274, 0x21e)
            }
            draw_texture(0xad0c + 0x2, 0x11, 0xcb, 0x22e, 0x2c, 0x1b, 0x2af, 0x21e)
            draw_texture(0xad0c + 0x3, 0x11, 0xf8, 0x22e, 0x2c, 0x1b, 0x2e0, 0x21e)
            draw_texture(0xad0c + 0x4, 0x11, 0x125, 0x22e, 0x2c, 0x1b, 0x311, 0x21e)
            draw_texture(0xad0c + 0x5, 0x11, 0x152, 0x22e, 0x2c, 0x1b, 0x342, 0x21e)
            draw_texture(0xad0c + 0x6, 0x11, 0x17f, 0x22e, 0x18, 0x13, 0x37d, 0x21e)
            if G[0x5d6] {
                draw_texture(0xad0c + 0x7, 0x11, 0x71, 0x24a, 0x2c, 0x1b, 0x243, 0x21e)
            }
            if G[0x5d7] {
                draw_texture(0xad0c + 0x8, 0x11, 0x9e, 0x24a, 0x2c, 0x1b, 0x274, 0x21e)
            }
            if G[0x5d8] {
                draw_texture(0xad0c + 0x9, 0x11, 0xcb, 0x24a, 0x2c, 0x1b, 0x2af, 0x21e)
            }
            if G[0x5d9] {
                draw_texture(0xad0c + 0xa, 0x11, 0xf8, 0x24a, 0x2c, 0x1b, 0x2e0, 0x21e)
            }
            if G[0x5da] {
                draw_texture(0xad0c + 0xb, 0x11, 0x125, 0x24a, 0x2c, 0x1b, 0x311, 0x21e)
            }
            if G[0x5db] {
                draw_texture(0xad0c + 0xc, 0x11, 0x152, 0x24a, 0x2c, 0x1b, 0x342, 0x21e)
            }
            if G[0x5dc] {
                draw_texture(0xad0c + 0xd, 0x11, 0x17f, 0x24a, 0x18, 0x13, 0x37d, 0x21e)
            }
            G[0x3fb88] = get_auto_message()
            G[0x3fb86] = get_message_skip_enabled()
            G[0x3fb87] = get_read_message_skip()
            gfx_draw_color(0xad0c + 0xe, 0x1, G[0x3fb88] * 0xff, 0xffffff)
            gfx_draw_color(0xad0c + 0xf, 0x1, G[0x3fb86] * 0xff, 0xffffff)
            gfx_draw_color(0xad0c + 0x10, 0x1, G[0x3fb87] * 0xff, 0xffffff)
        }
        G[0x3fba9] = op_0x215(0xad0c + 0xe)
        if G[0x3fba9] < 0x0 {
            draw_texture(0xad0c + 0xe, 0x3e, 0x0, 0x0, 0x40, 0x20, 0x2d6, 0x21b)
            animate_gfx_srcrect_loop(0xad0c + 0xe, 0x32, 0xc, 0x3)
            draw_texture(0xad0c + 0xf, 0x3f, 0x0, 0x0, 0x40, 0x20, 0x307, 0x21b)
            animate_gfx_srcrect_loop(0xad0c + 0xf, 0x32, 0xc, 0x3)
            draw_texture(0xad0c + 0x10, 0x40, 0x0, 0x0, 0x40, 0x20, 0x338, 0x21b)
            animate_gfx_srcrect_loop(0xad0c + 0x10, 0x32, 0xc, 0x3)
        }
        goto draw_message_window_1
    }
    for G[0x3fba8] = 0xad0c; G[0x3fba8] < 0xad0c + 0xe; G[0x3fba8] += 0x1 {
        gfx_draw_color(G[0x3fba8], 0x0, 0x0, 0xffffff)
    }
draw_message_window_1:
    return
}
@guard sub begin_window_transition {
    atomic {
        return
        exit
    fade_message_window:
        if G[0x5cc] {
            G[0x5d0] = get_message_window_alpha()
            G[0x3fb8b] = 0x10 - G[0x5d0] << 0x4
            gfx_draw_color(0xabe0, 0x0, 0x0, G[0x36ea])
            gfx_blit_color(0xabe0, 0x0, G[0x3fbcd], G[0x3fb8b], -(0x1))
            gfx_draw_color(0xabe0 + 0x1, 0x0, 0x0, 0xffffff)
