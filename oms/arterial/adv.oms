    GF[0x7] = mov_float(0x400)
    GF[0x8] = mov_float(0x0)
    GF[0x9] = mov_float(0x0)
    GF[0xa] = mov_float(0x240)
    GF[0xb] = mov_float(0x240)
    create_polygon(0xa7f8, GF[0x4], GF[0x8], GF[0xc], G[0x214811], G[0x214815], GF[0x10], GF[0x14], 0x4, 0x0)
    set_polygon_color(0xa7f8, 0x0, 0xff, 0x0)
    G[0x35fb] = 0x0
    G[0x35fc] = 0xff
    G[0x35fd] = 0x0
    G[0x35fe] = G[0x35fc]
    G[0x35ff] = G[0x35fd]
    if 0x1 {
        set_polygon_color(0xa7f8, G[0x35fb], 0x0, G[0x35ff])
        fade_polygon_color(0xa7f8, 0x0, 0x1ea, G[0x35fe], G[0x35ff])
        G[0x35fc] = G[0x35fe]
    } else {
        fade_polygon_color(0xa7f8, 0x0, 0x1ea, 0x0, G[0x35ff])
        G[0x35fc] = 0x0
    }
    G[0x35fd] = G[0x35ff]
    G[0x3fbd1] = 0x1
    present_window_transition()
    return
}
