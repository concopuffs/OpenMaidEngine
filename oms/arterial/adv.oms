    if G[0x3fbcb] == 0x2 {
        G[0x3fbc8] = G[0x3fbc5] + G[0x3fbaa]
        G[0x3fbc9] = G[0x3fbc6]
        goto get_layer_anchor_1
    }
    if G[0x3fbcb] == 0x3 {
        G[0x3fbc8] = G[0x3fbc5]
        G[0x3fbc9] = G[0x3fbc6] + G[0x3fbab] / 0x2
        goto get_layer_anchor_1
    }
    if G[0x3fbcb] == 0x4 {
        G[0x3fbc8] = G[0x3fbc5] + G[0x3fbaa] / 0x2
        G[0x3fbc9] = G[0x3fbc6] + G[0x3fbab] / 0x2
