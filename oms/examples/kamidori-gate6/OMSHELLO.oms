oms 1
// Gate 6 (spec §12), Kamidori: record 1 of the generated append catalog, a new script the edited SC0000 calls by
// packed id (run 0x4000001). It leaves a message in a second unused string cell.
script "$4$OMSHELLO.BIN"

    GS[0x9001] = set_string("[OMS] SC0000 called a new script in the append catalog.")
    exit
