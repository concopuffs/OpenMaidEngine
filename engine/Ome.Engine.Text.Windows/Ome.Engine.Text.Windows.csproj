<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The engine ships compiled with NativeAOT (platform-portability.md, "Fewer files in a package"). -->
    <IsAotCompatible>true</IsAotCompatible>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ome.Engine\Ome.Engine.csproj" />
    <ProjectReference Include="..\Ome.Engine.Devices\Ome.Engine.Devices.csproj" />
  </ItemGroup>

</Project>
