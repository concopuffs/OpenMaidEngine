<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lua scripting spec §7.1: every instruction the tests run is checked against its opcode's control facts
         (vm-map/opcodes.toml waits and leaves; engine/Ome.Engine.Vm/VirtualMachine.OpcodeFlow.cs). -->
    <RuntimeHostConfigurationOption Include="Ome.Engine.CheckOpcodeFlow" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ome.Engine\Ome.Engine.csproj" />
    <ProjectReference Include="..\Ome.Engine.Devices\Ome.Engine.Devices.csproj" />
    <ProjectReference Include="..\Ome.Engine.Vm\Ome.Engine.Vm.csproj" />
    <ProjectReference Include="..\Ome.Engine.Frontend\Ome.Engine.Frontend.csproj" />
    <ProjectReference Include="..\Ome.Engine.Text.Windows\Ome.Engine.Text.Windows.csproj" />
    <ProjectReference Include="..\Ome.Script\Ome.Script.csproj" />
    <ProjectReference Include="..\Ome.Mods\Ome.Mods.csproj" />
    <ProjectReference Include="..\Ome.Scripting.Lua\Ome.Scripting.Lua.csproj" />
    <!-- Built, not loaded: the run lock tests (launcher spec §5.5, gate 4) start Ome.Cli as a second process. -->
    <ProjectReference Include="..\Ome.Cli\Ome.Cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
