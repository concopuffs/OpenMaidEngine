<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The engine ships compiled with NativeAOT (platform-portability.md, "Fewer files in a package"). -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ome.Engine\Ome.Engine.csproj" />
    <ProjectReference Include="..\Ome.Engine.Devices\Ome.Engine.Devices.csproj" />
    <ProjectReference Include="..\Ome.Engine.Vm\Ome.Engine.Vm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shell's string tables (Shell/ShellStrings.cs). -->
    <EmbeddedResource Include="Shell\Strings\*.json" LogicalName="Ome.Engine.Frontend.Shell.Strings.%(Filename).json" />
  </ItemGroup>

</Project>
