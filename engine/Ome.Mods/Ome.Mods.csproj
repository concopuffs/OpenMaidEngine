<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Ome.Engine\Ome.Engine.csproj" />
    <ProjectReference Include="..\Ome.Script\Ome.Script.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

  <!-- The base mods the engine ships (Lua scripting spec §9.1): mods/<profile>-base/, read by ShippedPackages. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\mods\**\*"
                      LogicalName="Ome.Mods.Shipped/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The engine ships compiled with NativeAOT (platform-portability.md, "Fewer files in a package"). -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

</Project>
