<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Ome.Engine\Ome.Engine.csproj" />
    <ProjectReference Include="..\Ome.Script\Ome.Script.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

  <!-- The packages the engine ships, read by ShippedPackages: the base mods, mods/<profile>-base/ (Lua scripting spec
       §9.1), and the library they require, mods/ome-records/ (data patches spec §6.4). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\mods\**\*"
                      LogicalName="Ome.Mods.Shipped/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The engine ships compiled with NativeAOT (platform-portability.md, "Fewer files in a package"). -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

</Project>
