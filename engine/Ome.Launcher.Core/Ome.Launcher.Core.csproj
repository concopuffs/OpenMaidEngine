       command. No Avalonia type: the OME-Launcher program (launcher/) is the presentation over it. net10.0, like
       every project. -->

  <ItemGroup>
    <ProjectReference Include="..\Ome.Engine\Ome.Engine.csproj" />
    <ProjectReference Include="..\Ome.Engine.Frontend\Ome.Engine.Frontend.csproj" />
    <ProjectReference Include="..\Ome.Mods\Ome.Mods.csproj" />
    <ProjectReference Include="..\Ome.Scripting.Lua\Ome.Scripting.Lua.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
