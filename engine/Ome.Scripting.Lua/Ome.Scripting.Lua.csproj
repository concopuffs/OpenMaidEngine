<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Lua runtime of docs/superpowers/specs/2026-11-10-lua-scripting-design.md §14.1: the only project that names the
       Lua library. It implements Ome.Engine's runtime seam (Ome.Engine.Modding) and references Ome.Engine only. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LuaCSharp" Version="0.5.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ome.Engine\Ome.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ome.Engine.Tests" />
  </ItemGroup>
</Project>
