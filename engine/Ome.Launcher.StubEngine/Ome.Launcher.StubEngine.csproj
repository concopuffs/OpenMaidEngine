<Project Sdk="Microsoft.NET.Sdk">

  <!-- The engine's stand-in in the launcher's tests (launcher plan §5.11, gate 9): it prints what a launch gave it on
       both streams and exits with the code it is told. The tests build it and start it; nothing loads it. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
