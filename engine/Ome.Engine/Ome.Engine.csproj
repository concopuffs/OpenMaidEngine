<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ome.Engine.Devices\Ome.Engine.Devices.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The movie native's runtime, feed and registry are internal; their tests reach them. -->
    <InternalsVisibleTo Include="Ome.Engine.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Profiles\*.json"
                      LogicalName="Ome.Engine.Profiles.%(Filename)%(Extension)" />
    <!-- The opcode table and contracts every linker of an install uses (launcher spec §5.9): the engine, Ome.Cli's omp
         commands and the launcher all read this copy (OpcodeTableJson.LoadEmbedded). -->
    <EmbeddedResource Include="..\..\build\opcodes.json" LogicalName="Ome.Engine.Runtime.opcodes.json" />
  </ItemGroup>

  <Target Name="RequireGeneratedRuntimeMetadata" BeforeTargets="PrepareForBuild"
          Condition="!Exists('..\..\build\opcodes.json')">
    <Error Text="Missing generated runtime metadata '..\..\build\opcodes.json'. Run 'py -3.11 -X utf8 tools\opcodes_build.py --build' from age-reimpl before building the engine." />
  </Target>

</Project>
