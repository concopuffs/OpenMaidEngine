<Project Sdk="Godot.NET.Sdk/4.7.0">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <!-- A release compiles the engine with NativeAOT, so the analyzers report a reflection-bound call as an error
         (Directory.Build.targets). -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <OmeNativeRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</OmeNativeRid>
    <OmeNativeRid Condition="'$(OmeNativeRid)' == '' and '$(GodotTargetPlatform)' == 'windows'">win-x64</OmeNativeRid>
    <OmeNativeRid Condition="'$(OmeNativeRid)' == '' and '$(GodotTargetPlatform)' == 'linuxbsd'">linux-x64</OmeNativeRid>
    <OmeNativeDirectory>..\build\native\$(OmeNativeRid)</OmeNativeDirectory>
    <!-- The version stamp and the package notices of a release program (Directory.Build.targets). -->
    <OmeProgram>true</OmeProgram>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GodotTargetPlatform)' == 'windows'">
    <DefineConstants>$(DefineConstants);OME_WINDOWS_GDI</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\engine\Ome.Engine\Ome.Engine.csproj" />
    <ProjectReference Include="..\engine\Ome.Engine.Devices\Ome.Engine.Devices.csproj" />
    <ProjectReference Include="..\engine\Ome.Engine.Vm\Ome.Engine.Vm.csproj" />
    <ProjectReference Include="..\engine\Ome.Engine.Frontend\Ome.Engine.Frontend.csproj" />
    <ProjectReference Include="..\engine\Ome.Mods\Ome.Mods.csproj" />
    <ProjectReference Include="..\engine\Ome.Scripting.Lua\Ome.Scripting.Lua.csproj" />
    <!-- The engine shell's own assets (godot/assets/, which Godot ignores): the options panel's font and the OME icon. -->
    <EmbeddedResource Include="assets\NotoSansJP-Regular.otf" LogicalName="OME.Assets.NotoSansJP-Regular.otf" />
    <EmbeddedResource Include="assets\ome-icon.svg" LogicalName="OME.Assets.ome-icon.svg" />
  </ItemGroup>
  <ItemGroup Condition="'$(GodotTargetPlatform)' == 'windows'">
    <ProjectReference Include="..\engine\Ome.Engine.Text.Windows\Ome.Engine.Text.Windows.csproj" />
  </ItemGroup>
  <!-- The release form (tools/publish_engine.py, which passes -p:PublishAot=true): one NativeAOT library, OME.dll or
       OME.so, that Godot loads from its data folder when the folder holds no .NET runtime (docs/platform-portability.md,
       "Fewer files in a package"). Godot's script lookup reads GodotSharp's and this assembly's metadata, so the
       trimmer keeps both whole. -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <NativeLib>Shared</NativeLib>
  </PropertyGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <TrimmerRootAssembly Include="GodotSharp" />
    <TrimmerRootAssembly Include="$(TargetName)" />
  </ItemGroup>
  <!-- -p:OmeDependencyList=FILE keeps the build's dependency list, which a NativeAOT publish leaves out: the library
       holds the packages, and the release's notices check reads the list (tools/publish_engine.py). -->
  <Target Name="KeepDependencyList" AfterTargets="Publish" Condition="'$(OmeDependencyList)' != ''">
    <Error Condition="!Exists('$(ProjectDepsFilePath)')"
           Text="the build's dependency list was not found: $(ProjectDepsFilePath)" />
    <Copy SourceFiles="$(ProjectDepsFilePath)" DestinationFiles="$(OmeDependencyList)" />
  </Target>
  <!-- The FFmpeg bundle beside a build, for runs from the build output. A release's NativeAOT publish leaves it out: the
       release build scripts stage it in the data folder themselves (tools/build-*-x64.sh). -->
  <ItemGroup Condition="'$(OmeNativeRid)' == 'win-x64' and '$(PublishAot)' != 'true'
                        and Exists('$(OmeNativeDirectory)\ome_movie_ffmpeg.dll')">
    <None Include="$(OmeNativeDirectory)\*.dll"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(OmeNativeDirectory)\FFmpeg-LICENSE.txt"
          Link="FFmpeg-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(OmeNativeDirectory)\FFmpeg-SOURCE.txt"
          Link="FFmpeg-SOURCE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(OmeNativeRid)' == 'linux-x64' and '$(PublishAot)' != 'true'
                        and Exists('$(OmeNativeDirectory)\libome_movie_ffmpeg.so')">
    <None Include="$(OmeNativeDirectory)\*.so*"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(OmeNativeDirectory)\FFmpeg-LICENSE.txt"
          Link="FFmpeg-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(OmeNativeDirectory)\FFmpeg-SOURCE.txt"
          Link="FFmpeg-SOURCE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
