<Project Sdk="Godot.NET.Sdk/4.7.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <AgeNativeRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</AgeNativeRid>
    <AgeNativeRid Condition="'$(AgeNativeRid)' == '' and '$(GodotTargetPlatform)' == 'windows'">win-x64</AgeNativeRid>
    <AgeNativeRid Condition="'$(AgeNativeRid)' == '' and '$(GodotTargetPlatform)' == 'linuxbsd'">linux-x64</AgeNativeRid>
    <AgeNativeDirectory>..\build\native\$(AgeNativeRid)</AgeNativeDirectory>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GodotTargetPlatform)' == 'windows'">
    <DefineConstants>$(DefineConstants);AGE_WINDOWS_GDI</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\engine\Age.Engine\Age.Engine.csproj" />
    <ProjectReference Include="..\engine\Age.Engine.Frontend\Age.Engine.Frontend.csproj" />
    <ProjectReference Include="..\engine\Age.Mods\Age.Mods.csproj" />
    <EmbeddedResource Include="..\build\opcodes.json"
                      LogicalName="OME.Runtime.opcodes.json" />
  </ItemGroup>
  <ItemGroup Condition="'$(GodotTargetPlatform)' == 'windows'">
    <ProjectReference Include="..\engine\Age.Engine.Text.Windows\Age.Engine.Text.Windows.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(AgeNativeRid)' == 'win-x64' and Exists('$(AgeNativeDirectory)\age_movie_ffmpeg.dll')">
    <None Include="$(AgeNativeDirectory)\*.dll"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(AgeNativeDirectory)\FFmpeg-LICENSE.txt"
          Link="FFmpeg-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(AgeNativeDirectory)\FFmpeg-SOURCE.txt"
          Link="FFmpeg-SOURCE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(AgeNativeRid)' == 'linux-x64' and Exists('$(AgeNativeDirectory)\libage_movie_ffmpeg.so')">
    <None Include="$(AgeNativeDirectory)\*.so*"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(AgeNativeDirectory)\FFmpeg-LICENSE.txt"
          Link="FFmpeg-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(AgeNativeDirectory)\FFmpeg-SOURCE.txt"
          Link="FFmpeg-SOURCE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The engine version ﾍﾙﾌﾟ > ﾊﾞｰｼﾞｮﾝ情報 shows (Age.Engine.Frontend.NativeResources.EngineIdentity): git describe
       of the checkout, "+" when it has uncommitted changes, unless the build passes -p:OmeVersion=... A build without
       git or a repository stores none, which the dialog shows as "unknown". -->
  <Target Name="OmeVersion" BeforeTargets="GetAssemblyAttributes">
    <Exec Condition="'$(OmeVersion)' == ''" Command="git describe --tags --match &quot;v[0-9]*&quot; --dirty=+ --always"
          WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true"
          IgnoreStandardErrorWarningFormat="true" EchoOff="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_OmeDescribed" />
      <Output TaskParameter="ExitCode" PropertyName="_OmeDescribeExit" />
    </Exec>
    <PropertyGroup>
      <OmeVersion Condition="'$(OmeVersion)' == '' and '$(_OmeDescribeExit)' == '0'">$(_OmeDescribed)</OmeVersion>
    </PropertyGroup>
    <ItemGroup Condition="'$(OmeVersion)' != ''">
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>OmeVersion</_Parameter1>
        <_Parameter2>$(OmeVersion)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
  <!-- A self-contained publish ships NuGet packages' files: the .NET runtime pack, System.Text.Encoding.CodePages and
       others. Each of those packages' own license and notice files (LICENSE*, THIRD-PARTY-NOTICES*, NOTICE* at the
       package root) is published beside them as <PackageId>-<file name>, as FFmpeg's license is
       (THIRD_PARTY_NOTICES.md, ".NET"; the packagers require the runtime pack's). -->
  <Target Name="PublishPackageNotices" AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <_OmeShippedPackage Include="%(ResolvedFileToPublish.NuGetPackageId)"
                          Condition="'%(ResolvedFileToPublish.NuGetPackageId)' != ''">
        <NuGetPackageId>%(ResolvedFileToPublish.NuGetPackageId)</NuGetPackageId>
        <NuGetPackageVersion>%(ResolvedFileToPublish.NuGetPackageVersion)</NuGetPackageVersion>
      </_OmeShippedPackage>
    </ItemGroup>
    <GetPackageDirectory Items="@(_OmeShippedPackage)" PackageFolders="@(AssetsFilePackageFolder)">
      <Output TaskParameter="Output" ItemName="_OmeShippedPackageDirectory" />
    </GetPackageDirectory>
    <ItemGroup>
      <_OmePackageNotice Include="%(_OmeShippedPackageDirectory.PackageDirectory)/LICENSE*;%(_OmeShippedPackageDirectory.PackageDirectory)/THIRD-PARTY-NOTICES*;%(_OmeShippedPackageDirectory.PackageDirectory)/NOTICE*"
                         Condition="'%(_OmeShippedPackageDirectory.PackageDirectory)' != ''">
        <PackageId>%(_OmeShippedPackageDirectory.NuGetPackageId)</PackageId>
      </_OmePackageNotice>
      <ResolvedFileToPublish Include="@(_OmePackageNotice)"
                             RelativePath="%(_OmePackageNotice.PackageId)-%(_OmePackageNotice.Filename)%(_OmePackageNotice.Extension)"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <Target Name="RequireGeneratedRuntimeMetadata" BeforeTargets="PrepareForBuild"
          Condition="!Exists('..\build\opcodes.json')">
    <Error Text="Missing generated runtime metadata '..\build\opcodes.json'. Run 'py -3.11 -X utf8 tools\opcodes_build.py --build' from age-reimpl before building Godot." />
  </Target>
</Project>
